function p_biorhythm(c: ChartData): string {
  const b = c.biorhythm
  const phaseColor = (v: number) => v > 40 ? '#4a9a40' : v > 0 ? '#8a8a30' : v > -40 ? '#8a5a20' : '#9a3020'
  return section(0, 'Biorhythm â€” à¸§à¸±à¸à¸ˆà¸±à¸à¸£à¸Šà¸µà¸§à¸´à¸•', 'ðŸ“ˆ', `
    <div class="grid-3" style="margin-bottom:12px;text-align:center">
      ${[['à¸£à¹ˆà¸²à¸‡à¸à¸²à¸¢',b.physical,b.physicalPhase,'Physical (23d)'],['à¸­à¸²à¸£à¸¡à¸“à¹Œ',b.emotional,b.emotionalPhase,'Emotional (28d)'],['à¸ªà¸•à¸´à¸›à¸±à¸à¸à¸²',b.intellectual,b.intellectualPhase,'Intellectual (33d)']].map(([l,v,p,en]) => `
        <div class="stat-card">
          <div class="val" style="color:${phaseColor(+v)}">${+v > 0 ? '+' : ''}${v}%</div>
          <div class="lbl">${esc(String(l))}</div>
          <div style="font-size:10px;color:#6a5a42;margin-top:2px">${esc(String(p))}</div>
        </div>`).join('')}
    </div>
    <div style="background:#0a1008;border-radius:8px;padding:12px;margin:8px 0">
      <div style="font-size:12px;color:#5a8a40;margin-bottom:6px">à¸§à¸±à¸à¸ˆà¸±à¸à¸£ à¸“ 14 à¹€à¸¡.à¸¢. 2026</div>
      ${[['Physical 23d', b.physical, '#4a9a40'],['Emotional 28d', b.emotional, '#5a6a90'],['Intellectual 33d', b.intellectual, '#9a7a30']].map(([l,v,col]) =>
        `<div style="margin:6px 0"><div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:2px"><span style="color:#9a8a72">${esc(String(l))}</span><span style="color:${col};font-weight:600">${+v > 0 ?'+':''}${v}%</span></div>
        <div style="background:#1a2010;border-radius:3px;height:6px"><div style="width:${Math.round((+v+100)/2)}%;height:6px;background:${col};border-radius:3px"></div></div></div>`
      ).join('')}
    </div>
    <div class="stat-card" style="margin-top:8px">
      <div class="val">${b.score}</div><div class="lbl">Biorhythm Score</div>
    </div>
    ${bar(b.score,'#5a7a30')}
    <p style="font-size:11px;color:#6a5a42;margin-top:8px">${esc(b.reading)}</p>
  `)
}

function p_vedicMahadasha(c: ChartData): string {
  const v = c.vedicMahadasha
  const DASHA_COLORS: Record<string,string> = {
    Jupiter:'#5a8a30', Venus:'#8a5a80', Sun:'#8a6020', Moon:'#5a7a9a',
    Mercury:'#3a7a60', Mars:'#9a3020', Saturn:'#4a4a5a', Rahu:'#5a3060', Ketu:'#6a5a30'
  }
  const col = DASHA_COLORS[v.currentDasha] ?? '#6a5a42'
  return section(0, 'Vedic Mahadasha â€” à¸Šà¹ˆà¸§à¸‡à¸”à¸²à¸§à¸›à¸à¸„à¸£à¸­à¸‡', 'ðŸ•‰ï¸', `
    <div class="grid-2" style="margin-bottom:12px">
      <div class="stat-card" style="border-color:${col}">
        <div class="val" style="color:${col};font-size:20px">${esc(v.currentDasha)}</div>
        <div class="lbl">Mahadasha à¸›à¸±à¸ˆà¸ˆà¸¸à¸šà¸±à¸™</div>
      </div>
      <div class="stat-card"><div class="val">${v.score}</div><div class="lbl">Mahadasha Score</div></div>
    </div>
    ${bar(v.score, col)}
    <table style="margin:12px 0"><tbody>
      ${row2('Mahadasha', v.currentDasha)}
      ${row2('à¸ªà¸´à¹‰à¸™à¸ªà¸¸à¸”', String(v.currentDashaEnd))}
      ${row2('Antardasha', v.antardasha)}
      ${row2('à¸„à¸¸à¸“à¸ à¸²à¸ž', v.dashaQuality)}
      ${row2('à¸˜à¸²à¸•à¸¸ Dasha', v.dashaElement)}
    </tbody></table>
    ${box('à¸à¸²à¸£à¸•à¸µà¸„à¸§à¸²à¸¡ Mahadasha', v.reading, ['Jupiter','Venus','Sun'].includes(v.currentDasha) ? 'green' : ['Saturn','Rahu','Ketu'].includes(v.currentDasha) ? 'red' : 'gold')}
    <p style="font-size:11px;color:#4a6a70;border-left:2px solid #3a5a60;padding:6px 10px;margin-bottom:8px"><strong>à¸•à¹‰à¸™à¸à¸³à¹€à¸™à¸´à¸”:</strong> Vimshottari Dasha à¹€à¸›à¹‡à¸™à¸£à¸°à¸šà¸š planetary periods à¹ƒà¸™ Vedic Jyotish à¸£à¸§à¸¡ 120 à¸›à¸µ à¸›à¸£à¸°à¸à¸­à¸šà¸”à¹‰à¸§à¸¢ 9 à¸”à¸²à¸§ à¹à¸•à¹ˆà¸¥à¸°à¸”à¸²à¸§à¸›à¸à¸„à¸£à¸­à¸‡ 6-20 à¸›à¸µ à¸„à¸³à¸™à¸§à¸“à¸ˆà¸²à¸ Nakshatra à¸‚à¸­à¸‡à¸”à¸§à¸‡à¸ˆà¸±à¸™à¸—à¸£à¹Œà¸“ à¹€à¸§à¸¥à¸²à¹€à¸à¸´à¸” â€” à¸–à¸·à¸­à¹€à¸›à¹‡à¸™à¸«à¸™à¸¶à¹ˆà¸‡à¹ƒà¸™à¹€à¸„à¸£à¸·à¹ˆà¸­à¸‡à¸¡à¸·à¸­à¸—à¸³à¸™à¸²à¸¢ timing à¸—à¸µà¹ˆà¹à¸¡à¹ˆà¸™à¸¢à¸³à¸—à¸µà¹ˆà¸ªà¸¸à¸”à¹ƒà¸™ Vedic system à¸¢à¸±à¸‡à¹ƒà¸Šà¹‰à¹à¸žà¸£à¹ˆà¸«à¸¥à¸²à¸¢à¹ƒà¸™à¸­à¸´à¸™à¹€à¸”à¸µà¸¢à¸ªà¸³à¸«à¸£à¸±à¸šà¸à¸²à¸£à¸•à¸±à¸”à¸ªà¸´à¸™à¹ƒà¸ˆà¸ªà¸³à¸„à¸±à¸</p>
    <p style="font-size:11px;color:#6a5a42">Vedic Mahadasha à¸à¸³à¸«à¸™à¸” "à¸Šà¹ˆà¸§à¸‡à¹€à¸§à¸¥à¸²" à¸—à¸µà¹ˆà¸”à¸²à¸§à¹à¸•à¹ˆà¸¥à¸°à¸”à¸§à¸‡à¸›à¸à¸„à¸£à¸­à¸‡à¸Šà¸µà¸§à¸´à¸• â€” ${v.currentDasha} (${v.dashaQuality}) à¸„à¸£à¸­à¸‡à¸ˆà¸™à¸–à¸¶à¸‡à¸›à¸µ ${v.currentDashaEnd}</p>
  `)
}


