function p25_summary(c: ChartData): string {
  const { score, bazi, numerology, ninestar, western } = c
  return section(25, 'à¸ªà¸£à¸¸à¸›à¸ à¸²à¸žà¸£à¸§à¸¡à¹à¸¥à¸°à¸„à¸³à¸ªà¹ˆà¸‡à¸—à¹‰à¸²à¸¢', 'âœ¨', `
