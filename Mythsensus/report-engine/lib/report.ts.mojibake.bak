function p23_forecast10yr(c: ChartData): string {
  const startYear = 2026
  const years = Array.from({length:10}, (_,i) => startYear + i)
  const { bazi, numerology } = c
  return section(23, 'à¸žà¸¢à¸²à¸à¸£à¸“à¹Œ 10 à¸›à¸µ 2026â€“2035', 'ðŸ”­', `
    <table>
      <thead><tr><th>à¸›à¸µ</th><th>PY</th><th>NSK</th><th>à¹à¸™à¸§à¹‚à¸™à¹‰à¸¡</th></tr></thead>
      <tbody>
        ${years.map(y => {
          const py = ((numerology.personalYear2026 - 1 + (y - 2026)) % 9) + 1
          const nsk = ((9 - (y - 2026)) % 9) || 9
          const good = py === 1||py===8||py===3 ? 'ðŸŸ¢' : py===4||py===7 ? 'ðŸ”´' : 'ðŸŸ¡'
          return `<tr>
            <td style="font-weight:600">${y}</td>
            <td style="color:#d4aa50">PY ${py}</td>
            <td style="font-size:11px;color:#9a8a72">Star ${nsk}</td>
            <td>${good} ${py===1?'à¹€à¸£à¸´à¹ˆà¸¡à¸•à¹‰à¸™à¹ƒà¸«à¸¡à¹ˆ':py===2?'à¸ªà¸£à¹‰à¸²à¸‡à¸„à¸§à¸²à¸¡à¸ªà¸±à¸¡à¸žà¸±à¸™à¸˜à¹Œ':py===3?'à¸ªà¸·à¹ˆà¸­à¸ªà¸²à¸£à¸‚à¸¢à¸²à¸¢':py===4?'à¸—à¸³à¸‡à¸²à¸™à¸«à¸™à¸±à¸':py===5?'à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¹à¸›à¸¥à¸‡':py===6?'à¸„à¸£à¸­à¸šà¸„à¸£à¸±à¸§':py===7?'à¸žà¸±à¸à¸Ÿà¸·à¹‰à¸™':py===8?'à¹€à¸à¹‡à¸šà¹€à¸à¸µà¹ˆà¸¢à¸§':'à¸ªà¸£à¸¸à¸›à¸›à¸´à¸”à¸‰à¸²à¸'}</td>
          </tr>`}).join('')}
      </tbody>
    </table>
    <p style="font-size:11px;color:#6a5a42;margin-top:8px">PY = Personal Year | ðŸŸ¢ à¸”à¸µ ðŸŸ¡ à¸›à¸²à¸™à¸à¸¥à¸²à¸‡ ðŸ”´ à¸£à¸°à¸§à¸±à¸‡</p>
    ${box('à¸Šà¹ˆà¸§à¸‡à¸—à¸­à¸‡', `à¸›à¸µ ${years.filter((_,i) => {const py=((numerology.personalYear2026-1+i)%9)+1; return py===1||py===8||py===3}).slice(0,3).join(', ')} â€” Personal Year à¸—à¸µà¹ˆà¸”à¸µà¸—à¸µà¹ˆà¸ªà¸¸à¸”à¹ƒà¸™à¸£à¸­à¸š 10 à¸›à¸µ`, 'green')}
  `)
}

