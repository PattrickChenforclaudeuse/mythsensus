function p21_historicalFigures(c: ChartData): string {
  // Figure pool â€” selected by Day Master element and Life Path
  type Figure = {name:string;years:string;element:string;lifePath:number[];nsk:number[];why:string}
  const FIGURE_POOL: Figure[] = [
    { name:'Steve Jobs', years:'1955â€“2011', element:'à¹„à¸Ÿ', lifePath:[1,5,7], nsk:[1,4,9], why:`à¸œà¸¹à¹‰à¸šà¸¸à¸à¹€à¸šà¸´à¸à¸”à¹‰à¸§à¸¢à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™${c.bazi.dayMasterElement} + Life Path ${c.numerology.lifePath} + à¸„à¸§à¸²à¸¡à¸à¸¥à¹‰à¸²à¸—à¸³à¸¥à¸²à¸¢à¸à¸£à¸­à¸šà¹€à¸”à¸´à¸¡` },
    { name:'Albert Einstein', years:'1879â€“1955', element:'à¹„à¸¡à¹‰', lifePath:[7,11,3], nsk:[3,6,9], why:`Life Path ${c.numerology.lifePath} à¸ªà¸¹à¹ˆà¸„à¸§à¸²à¸¡à¸ˆà¸£à¸´à¸‡à¸­à¸±à¸™à¸¥à¸¶à¸à¸‹à¸¶à¹‰à¸‡ + ${c.western.sunSignTh}à¸—à¸µà¹ˆà¹ƒà¸«à¹‰à¸›à¸±à¸à¸à¸²à¹à¸¥à¸°à¸ªà¸±à¸à¸Šà¸²à¸•à¸à¸²à¸“` },
    { name:'Marie Curie', years:'1867â€“1934', element:'à¸™à¹‰à¸³', lifePath:[7,6,9], nsk:[1,8,6], why:`à¸„à¸§à¸²à¸¡à¸¥à¸¶à¸à¸‚à¸­à¸‡${c.bazi.dayMasterElement} + NSK ${c.ninestar.star} + à¸„à¸§à¸²à¸¡à¸­à¸”à¸—à¸™à¸ªà¸¹à¹ˆà¸„à¸§à¸²à¸¡à¸ªà¸³à¹€à¸£à¹‡à¸ˆà¸—à¸µà¹ˆà¸¢à¸´à¹ˆà¸‡à¹ƒà¸«à¸à¹ˆ` },
    { name:'Leonardo da Vinci', years:'1452â€“1519', element:'à¹„à¸¡à¹‰', lifePath:[5,11,3], nsk:[3,4,9], why:`à¸„à¸£à¸µà¹€à¸­à¸—à¸µà¸Ÿà¸ªà¸¹à¸‡à¸ªà¸¸à¸”à¸ˆà¸²à¸${c.bazi.dayMasterElement} + Celtic ${c.celtic.treeName} + à¸„à¸§à¸²à¸¡à¸­à¸¢à¸²à¸à¸£à¸¹à¹‰à¹„à¸¡à¹ˆà¸ªà¸´à¹‰à¸™à¸ªà¸¸à¸”` },
    { name:'Frida Kahlo', years:'1907â€“1954', element:'à¹„à¸Ÿ', lifePath:[3,9,6], nsk:[9,3,7], why:`à¸žà¸¥à¸±à¸‡à¸ªà¸£à¹‰à¸²à¸‡à¸ªà¸£à¸£à¸„à¹Œà¸ˆà¸²à¸à¸ à¸²à¸¢à¹ƒà¸™ + à¸˜à¸²à¸•à¸¸${c.bazi.dayMasterElement} + NSK ${c.ninestar.star} à¸—à¸µà¹ˆà¹‚à¸”à¸”à¹€à¸”à¹ˆà¸™` },
    { name:'Nikola Tesla', years:'1856â€“1943', element:'à¹‚à¸¥à¸«à¸°', lifePath:[1,7,11], nsk:[1,7,4], why:`à¸”à¸²à¸§${c.ninestar.star} + à¸˜à¸²à¸•à¸¸${c.bazi.dayMasterElement} + Life Path ${c.numerology.lifePath} à¸œà¸ªà¸²à¸™à¸ˆà¸´à¸™à¸•à¸™à¸²à¸à¸²à¸£à¹à¸¥à¸°à¸§à¸´à¸—à¸¢à¸²à¸¨à¸²à¸ªà¸•à¸£à¹Œ` },
    { name:'Coco Chanel', years:'1883â€“1971', element:'à¸”à¸´à¸™', lifePath:[8,4,1], nsk:[8,2,6], why:`à¸˜à¸²à¸•à¸¸${c.bazi.dayMasterElement} + NSK ${c.ninestar.star} à¸«à¸™à¸¸à¸™à¸£à¸ªà¸™à¸´à¸¢à¸¡à¹à¸¥à¸°à¸à¸²à¸£à¸ªà¸£à¹‰à¸²à¸‡à¸•à¸±à¸§à¸•à¸™` },
    { name:'Laozi (è€å­)', years:'à¸£à¸²à¸§ 600 à¸›à¸µà¸à¹ˆà¸­à¸™ à¸„.à¸¨.', element:'à¸™à¹‰à¸³', lifePath:[7,9,4], nsk:[1,6,8], why:`à¸„à¸§à¸²à¸¡à¸¥à¸¶à¸à¸‚à¸­à¸‡à¸™à¹‰à¸³à¸˜à¸²à¸•à¸¸ + à¸›à¸±à¸à¸à¸²à¸—à¸µà¹ˆà¹€à¸à¸´à¸”à¸ˆà¸²à¸à¸à¸²à¸£à¸ªà¸±à¸‡à¹€à¸à¸• â€” Life Path ${c.numerology.lifePath}` },
  ]
  // Score each figure by matching: element match (+3), lifePath match (+2), nsk match (+2), base from chart
  const dm = c.bazi.dayMasterElement
  const lp = c.numerology.lifePath
  const ns = c.ninestar.star
  const scoredFigures = FIGURE_POOL.map(f => {
    const matchPts = (f.element === dm ? 3 : 0) + (f.lifePath.includes(lp) ? 2 : 0) + (f.nsk.includes(ns) ? 2 : 0)
    // Score = chart total adjusted for figure match (not hardcoded)
    const figureScore = Math.min(999, Math.round(c.score.total * 0.9 + matchPts * 8 + (f.lifePath[0] * 3)))
    return { ...f, score: figureScore, matchPts }
  })
  const figures = scoredFigures.sort((a,b) => b.matchPts - a.matchPts).slice(0, 4)
  return section(21, 'à¸šà¸¸à¸„à¸„à¸¥à¸›à¸£à¸°à¸§à¸±à¸•à¸´à¸¨à¸²à¸ªà¸•à¸£à¹Œ â€” à¸”à¸§à¸‡à¸„à¸¥à¹‰à¸²à¸¢à¸„à¸¸à¸“', 'ðŸ›ï¸', `
    <p style="margin-bottom:12px">à¸„à¸±à¸”à¹€à¸¥à¸·à¸­à¸à¸ˆà¸²à¸à¸¥à¸±à¸à¸©à¸“à¸°à¸Šà¸²à¸£à¹Œà¸•à¸—à¸µà¹ˆà¸„à¸¥à¹‰à¸²à¸¢à¸à¸±à¸™ â€” à¹„à¸¡à¹ˆà¹ƒà¸Šà¹ˆà¸à¸²à¸£à¸—à¸³à¸™à¸²à¸¢à¸§à¹ˆà¸²à¸ˆà¸°à¹€à¸›à¹‡à¸™à¹à¸šà¸šà¸žà¸§à¸à¹€à¸‚à¸² à¹à¸•à¹ˆà¹à¸ªà¸”à¸‡à¹ƒà¸«à¹‰à¹€à¸«à¹‡à¸™à¸§à¹ˆà¸²à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¸™à¸µà¹‰à¸™à¸³à¹„à¸›à¸ªà¸¹à¹ˆà¸­à¸°à¹„à¸£à¹„à¸”à¹‰</p>
    ${figures.map(f => `
      <div style="border:1px solid #2a2010;border-radius:8px;margin:10px 0;overflow:hidden">
        <div style="background:#151210;padding:10px 14px;display:flex;justify-content:space-between;align-items:center">
          <div>
            <span style="font-weight:700;color:#d4aa50">${esc(f.name)}</span>
            <span style="font-size:11px;color:#6a5a42;margin-left:8px">${esc(f.years)}</span>
          </div>
          <span style="font-size:18px;font-weight:700;color:#d4aa50">${f.score}</span>
        </div>
        <div style="padding:10px 14px;font-size:12px;color:#9a8a72">${esc(f.why)}</div>
      </div>`).join('')}
  `)
}

