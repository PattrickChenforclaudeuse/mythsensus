          <div style="font-size:10px;color:#5a3020">[${esc(n.source)}]</div>
        </div>
      </div>`).join('')}
  `)
}

function p17_weekly(c: ChartData): string {
  const days = ['à¸ˆà¸±à¸™à¸—à¸£à¹Œ','à¸­à¸±à¸‡à¸„à¸²à¸£','à¸žà¸¸à¸˜','à¸žà¸¤à¸«à¸±à¸ªà¸šà¸”à¸µ','à¸¨à¸¸à¸à¸£à¹Œ','à¹€à¸ªà¸²à¸£à¹Œ','à¸­à¸²à¸—à¸´à¸•à¸¢à¹Œ']
  const focuses = ['à¸§à¸²à¸‡à¹à¸œà¸™ + à¸•à¸±à¹‰à¸‡à¹€à¸ˆà¸•à¸™à¸²','à¸¥à¸‡à¸¡à¸·à¸­à¸—à¸³ + à¸à¸´à¸ˆà¸à¸£à¸£à¸¡à¸ªà¸³à¸„à¸±à¸','à¸ªà¸·à¹ˆà¸­à¸ªà¸²à¸£ + à¹€à¸„à¸£à¸·à¸­à¸‚à¹ˆà¸²à¸¢','à¸‚à¸¢à¸²à¸¢à¸‡à¸²à¸™ + à¹€à¸£à¸µà¸¢à¸™à¸£à¸¹à¹‰','à¸ªà¸£à¸¸à¸›à¸œà¸¥ + à¸›à¸£à¸±à¸šà¸›à¸£à¸¸à¸‡','à¸žà¸±à¸ + à¹€à¸•à¸´à¸¡à¸žà¸¥à¸±à¸‡ + à¸ªà¸£à¹‰à¸²à¸‡à¸ªà¸£à¸£à¸„à¹Œ','à¸—à¸³à¸šà¸¸à¸ + à¸ªà¸³à¸£à¸§à¸ˆà¸ˆà¸´à¸•à¹ƒà¸ˆ']
  return section(17, 'Weekly Energy Plan â€” à¸•à¸²à¸£à¸²à¸‡à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™ 7 à¸§à¸±à¸™', 'ðŸ“…', `
    <table>
      <thead><tr><th>à¸§à¸±à¸™</th><th>à¹‚à¸Ÿà¸à¸±à¸ª</th><th>à¸„à¸³à¹à¸™à¸°à¸™à¸³</th></tr></thead>
      <tbody>
        ${days.map((d,i) => `<tr ${d === c.thai.dayName ? 'style="background:#1e1a0e"' : ''}>
          <td style="font-weight:600;color:${d === c.thai.dayName ? '#d4aa50' : '#c8c0a8'}">${esc(d)}${d === c.thai.dayName ? ' â˜…' : ''}</td>
          <td>${esc(focuses[i])}</td>
          <td style="font-size:11px;color:#9a8a72">${i === 0 ? 'à¹ƒà¸ªà¹ˆà¸ªà¸µà¸¡à¸‡à¸„à¸¥' : i === 4 ? 'Reflect journal' : i === 5 ? 'à¸­à¸­à¸à¸à¸³à¸¥à¸±à¸‡à¸à¸²à¸¢' : i === 6 ? 'à¸—à¸³à¸šà¸¸à¸+à¸ªà¸¡à¸²à¸˜à¸´' : 'Follow strategy'}</td>
        </tr>`).join('')}
      </tbody>
    </table>
    ${box('à¸«à¸¡à¸²à¸¢à¹€à¸«à¸•à¸¸', `à¸§à¸±à¸™${c.thai.dayName} (â˜…) à¸„à¸·à¸­à¸§à¸±à¸™à¹€à¸à¸´à¸”à¸‚à¸­à¸‡à¸„à¸¸à¸“ â€” à¸„à¸§à¸£à¸—à¸³à¸à¸´à¸ˆà¸à¸£à¸£à¸¡à¸¡à¸‡à¸„à¸¥à¹ƒà¸™à¸§à¸±à¸™à¸™à¸µà¹‰à¸—à¸¸à¸à¸ªà¸±à¸›à¸”à¸²à¸«à¹Œ`, 'gold')}
  `)
}

function p18_monthly2026(c: ChartData): string {
  const months = ['à¸¡.à¸„.','à¸.à¸ž.','à¸¡à¸µ.à¸„.','à¹€à¸¡.à¸¢.','à¸ž.à¸„.','à¸¡à¸´.à¸¢.','à¸.à¸„.','à¸ª.à¸„.','à¸.à¸¢.','à¸•.à¸„.','à¸ž.à¸¢.','à¸˜.à¸„.']
  const monthStars = [2,8,7,6,5,4,3,2,1,9,8,7]
  const starNames = ['','ä¸€ç™½æ°´æ˜Ÿ','äºŒé»’åœŸæ˜Ÿ','ä¸‰ç¢§æœ¨æ˜Ÿ','å››ç·‘æœ¨æ˜Ÿ','äº”é»„åœŸæ˜Ÿ','å…­ç™½é‡‘æ˜Ÿ','ä¸ƒèµ¤é‡‘æ˜Ÿ','å…«ç™½åœŸæ˜Ÿ','ä¹ç´«ç«æ˜Ÿ']
  const STAR_EL: Record<number,string> = {1:'Water',2:'Earth',3:'Wood',4:'Wood',5:'Earth',6:'Metal',7:'Metal',8:'Earth',9:'Fire'}
  const SHENG: Record<string,string> = {Wood:'Fire',Fire:'Earth',Earth:'Metal',Metal:'Water',Water:'Wood'}
  const KE: Record<string,string>    = {Wood:'Earth',Earth:'Water',Water:'Fire',Fire:'Metal',Metal:'Wood'}
  const natal = c.ninestar.star

  // Biorhythm monthly peaks (approximate by days elapsed)
  const birthJD = Math.floor(2451545 + (c.input.year-2000)*365.25 + c.input.month*30 + c.input.day)
  const monthBiorhythm = months.map((_, mi) => {
    const days = Math.round((2026 - c.input.year)*365.25) + (mi * 30)
    const phy = Math.round(Math.sin(2*Math.PI*days/23)*100)
    const emo = Math.round(Math.sin(2*Math.PI*days/28)*100)
    const int = Math.round(Math.sin(2*Math.PI*days/33)*100)
    return { phy, emo, int, avg: Math.round((phy+emo+int)/3) }
  })

  // Vedic monthly quality (based on dasha sub-period)
  const vedicMonthQuality = months.map((_, mi) => {
    const py = ((c.numerology.personalYear2026 - 1 + mi) % 9) + 1
    return [1,3,6,8].includes(py) ? 'à¸”à¸µ' : [5].includes(py) ? 'à¸£à¸°à¸§à¸±à¸‡' : 'à¸›à¸²à¸™à¸à¸¥à¸²à¸‡'
  })

  function monthRating(ms: number, bioAvg: number): { icon: string; score: number } {
    let base = 0
    if (ms === natal) base = 3
    else if (SHENG[STAR_EL[ms]??''] === 'Fire') base = 2
    else if (KE[STAR_EL[ms]??''] === 'Fire') base = -1
    if (ms === 5) base -= 1
    const bioBonus = bioAvg > 40 ? 1 : bioAvg < -40 ? -1 : 0
    const total = base + bioBonus
    const icon = ms===natal?'ðŸŒŸ': total>=2?'ðŸŸ¢': total>=0?'ðŸŸ¡': 'ðŸ”´'
    return { icon, score: total }
  }

  return section(16, 'à¸žà¸¢à¸²à¸à¸£à¸“à¹Œà¸£à¸²à¸¢à¹€à¸”à¸·à¸­à¸™ 2026 â€” 3 à¸¨à¸²à¸ªà¸•à¸£à¹Œ Consensus', 'ðŸ—“ï¸', `
    <div style="font-size:11px;color:#7a6a52;margin-bottom:10px">
      à¸£à¸§à¸¡à¸ªà¸±à¸à¸à¸²à¸“à¸ˆà¸²à¸ Nine Star Ki (natal ${natal}) + Biorhythm + Numerology PY pattern
    </div>
    <table>
      <thead>
        <tr>
          <th>à¹€à¸”à¸·à¸­à¸™</th>
          <th>NSK</th>
          <th>Bio avg</th>
          <th>PY-pattern</th>
          <th>Consensus</th>
          <th>à¹à¸™à¸°à¸™à¸³</th>
        </tr>
      </thead>
      <tbody>
        ${months.map((m,i) => {
          const ms = monthStars[i]
          const bio = monthBiorhythm[i]
          const nskRating = monthRating(ms, bio.avg)
          const advice = nskRating.icon==='ðŸŒŸ'?'à¹‚à¸­à¸à¸²à¸ªà¸—à¸­à¸‡à¹ƒà¸™à¸›à¸µà¸™à¸µà¹‰':
                        nskRating.icon==='ðŸŸ¢'?'à¸¥à¸‡à¸¡à¸·à¸­à¸—à¸³à¹„à¸”à¹‰à¹€à¸¥à¸¢':
                        nskRating.icon==='ðŸŸ¡'?'à¸„à¹ˆà¸­à¸¢à¹† à¸‚à¸¢à¸±à¸š':
                        'à¸£à¸°à¸§à¸±à¸‡ à¸¢à¸±à¸šà¸¢à¸±à¹‰à¸‡à¸Šà¸±à¹ˆà¸‡à¹ƒà¸ˆ'
          return `<tr>
            <td style="font-weight:600">${esc(m)}</td>
            <td style="font-size:11px">${ms} ${esc(starNames[ms])}</td>
            <td style="font-size:11px;color:${bio.avg>30?'#60c060':bio.avg<-30?'#c06060':'#c0a060'}">${bio.avg>0?'+':''}${bio.avg}%</td>
            <td style="font-size:11px;color:#9a8a72">${esc(vedicMonthQuality[i])}</td>
            <td style="text-align:center">${nskRating.icon}</td>
