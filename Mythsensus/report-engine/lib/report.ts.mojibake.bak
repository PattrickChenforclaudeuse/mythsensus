// â”€â”€ MAIN EXPORT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
export function generateReport(c: ChartData): string {
  _pageNum = 0  // reset counter for each report
  const pages = [
    // â”€â”€â”€ 1-4: Front matter â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    p01_cover,           // 1. à¸›à¸ + Cosmic Score + 3-score preview
    p_threeScores,       // 2. Soul Frequency (petroleum) deep dive
    p02_scoreBreakdown,  // 3. 26-system consensus (ðŸŒŸã€°âš  grouped)
