    { icon:'ðŸŽ¯', title:`à¸—à¸³à¸•à¸²à¸¡ Strategy "${humandesign.strategy}"`, pts:0, body:`Energy Type ${humandesign.typeTh}: à¸«à¸±à¸§à¹ƒà¸ˆà¸‚à¸­à¸‡ Human Design â€” à¸à¸·à¸™à¹à¸¥à¹‰à¸§à¹€à¸«à¸™à¸·à¹ˆà¸­à¸¢à¹€à¸›à¸¥à¹ˆà¸²`, systems:['Energy Type System','Kabbalistic (${kabbalistic.archangel})'] },
    { icon:'ðŸ”¥', title:`à¹€à¸ªà¸£à¸´à¸¡à¸˜à¸²à¸•à¸¸${bazi.luckyElement}à¸—à¸¸à¸à¸§à¸±à¸™`, pts:0, body:`BaZi: à¸˜à¸²à¸•à¸¸à¸¡à¸‡à¸„à¸¥${bazi.luckyElement} à¸«à¸™à¸¸à¸™ Day Master ${bazi.dayMasterTh}`, systems:['BaZi','Saju (Korean)','Tibetan Mewa'] },
    { icon:'ðŸŽ¨', title:`à¹ƒà¸ªà¹ˆà¸ªà¸µ${ninestar.starColor}à¹€à¸›à¹‡à¸™ accent`, pts:0, body:`NSK ${ninestar.starChinese} + à¹„à¸—à¸¢à¸žà¸£à¸²à¸«à¸¡à¸“à¹Œà¸§à¸±à¸™${thai.dayName}: à¸ªà¸µ${ninestar.starColor}/${thai.dayColor}`, systems:['Nine Star Ki','à¹„à¸—à¸¢à¸žà¸£à¸²à¸«à¸¡à¸“à¹Œ','Celtic'] },
    { icon:'ðŸ“', title:`Journal à¸—à¸¸à¸à¹€à¸Šà¹‰à¸² â€” à¸•à¸±à¹‰à¸‡à¹€à¸ˆà¸•à¸™à¸²`, pts:0, body:`Life Path ${numerology.lifePath} + Kabbalistic ${kabbalistic.sephira}: à¸„à¸§à¸²à¸¡à¸Šà¸±à¸”à¹€à¸ˆà¸™à¹ƒà¸™à¸„à¸§à¸²à¸¡à¸„à¸´à¸”à¹€à¸›à¹‡à¸™à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™`, systems:['Numerology','Kabbalistic','Zoroastrian'] },
    { icon:'ðŸ™', title:`à¸—à¸³à¸žà¸´à¸˜à¸µà¸à¸£à¸£à¸¡à¸§à¸±à¸™${thai.dayName}`, pts:0, body:`à¹„à¸—à¸¢à¸žà¸£à¸²à¸«à¸¡à¸“à¹Œ + Zoroastrian ${zoroastrian.dayYazataTh}: à¸ªà¸±à¸à¸à¸²à¸£à¸°à¹ƒà¸™à¸§à¸±à¸™à¹€à¸à¸´à¸”à¸‚à¸­à¸‡à¸ªà¸±à¸›à¸”à¸²à¸«à¹Œ`, systems:['à¹„à¸—à¸¢à¸žà¸£à¸²à¸«à¸¡à¸“à¹Œ','Zoroastrian','OnmyÅdÅ'] },
    { icon:'ðŸŒ¿', title:`à¸­à¸­à¸à¸à¸³à¸¥à¸±à¸‡à¸à¸²à¸¢ 3x/à¸ªà¸±à¸›à¸”à¸²à¸«à¹Œ`, pts:0, body:`Biorhythm Physical ${biorhythm.physical}% (${biorhythm.physicalPhase}) + ${celtic.treeNameTh} à¸˜à¸²à¸•à¸¸${celtic.element}`, systems:['Biorhythm','Celtic','Native American'] },
    { icon:'ðŸ’¬', title:`à¸£à¸­ Response à¸à¹ˆà¸­à¸™à¸¥à¸‡à¸¡à¸·à¸­`, pts:0, body:`${humandesign.typeTh} Authority ${humandesign.authority}: à¸•à¸±à¸”à¸ªà¸´à¸™à¹ƒà¸ˆà¸•à¸²à¸¡ inner response`, systems:['Energy Type System','Norse Rune (${norseRune.runeName})'] },
    { icon:'ðŸ—ºï¸', title:`à¸§à¸²à¸‡à¹à¸œà¸™à¸—à¸´à¸¨${ninestar.starDirection}`, pts:0, body:`NSK à¸—à¸´à¸¨à¹‚à¸Šà¸„${ninestar.starDirection} à¸›à¸µ 2026: à¹ƒà¸Šà¹‰à¸—à¸´à¸¨à¸™à¸µà¹‰à¹ƒà¸™à¸à¸²à¸£à¹€à¸”à¸´à¸™à¸—à¸²à¸‡à¹à¸¥à¸°à¸ˆà¸±à¸”à¹‚à¸•à¹Šà¸°à¸—à¸³à¸‡à¸²à¸™`, systems:['Nine Star Ki','Arabic Parts (${arabicParts.fortuneSign})'] },
    { icon:'ðŸŒŸ', title:`à¹€à¸Šà¸·à¹ˆà¸­à¸¡à¸à¸±à¸š OdÃ¹ ${ifaYoruba.odu}`, pts:0, body:`Ifa/Yoruba: ${ifaYoruba.oduTh} â€” ${ifaYoruba.oduTheme}`, systems:['Ifa/Yoruba','Aboriginal (${aboriginal.dreamingTh})'] },
  ]

  // Pull negative inputs (things to avoid) from low-scoring systems + BaZi avoidance
  const negatives: {icon:string;title:string;body:string;source:string}[] = [
    { icon:'ðŸš«', title:`à¸«à¸¥à¸µà¸à¹€à¸¥à¸µà¹ˆà¸¢à¸‡à¸˜à¸²à¸•à¸¸${bazi.avoidElement}`, body:`BaZi: à¸˜à¸²à¸•à¸¸${bazi.avoidElement}à¸à¸”à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™ Day Master â€” à¸¥à¸”à¸ªà¸µà¹à¸¥à¸°à¸­à¸²à¸«à¸²à¸£à¸—à¸µà¹ˆà¸ªà¸­à¸”à¸„à¸¥à¹‰à¸­à¸‡`, source:'BaZi' },
    { icon:'âš ï¸', title:`à¸£à¸°à¸§à¸±à¸‡ Self-Punishment åˆåˆ`, body:`BaZi: ${bazi.dayStem}${bazi.dayBranch} + ${bazi.yearStem}${bazi.yearBranch} à¸¡à¸µà¹à¸£à¸‡à¸à¸”à¸”à¸±à¸™à¸•à¸±à¸§à¹€à¸­à¸‡ â€” à¸­à¸¢à¹ˆà¸² overthink`, source:'BaZi Self-Punch' },
    ...(c.score.breakdown.filter(b => b.score < 650).map(b => ({
      icon: 'âš ï¸', title: `à¸£à¸°à¸§à¸±à¸‡: ${b.system}`, body: b.finding, source: b.system
    }))),
    { icon:'ðŸ”´', title:`${onmyodo.rokuyo} Birth Day â€” à¸£à¸°à¸§à¸±à¸‡à¸ªà¸´à¹ˆà¸‡à¸™à¸µà¹‰`, body:`OnmyÅdÅ ${onmyodo.rokuyoTh}: à¸§à¸±à¸™à¹€à¸à¸´à¸”à¸¡à¸µà¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™${onmyodo.rokuyo} â€” à¸£à¸°à¸¡à¸±à¸”à¸£à¸°à¸§à¸±à¸‡à¹ƒà¸™à¸§à¸±à¸™à¹€à¸”à¸µà¸¢à¸§à¸à¸±à¸™à¸‚à¸­à¸‡à¸ªà¸±à¸›à¸”à¸²à¸«à¹Œ`, source:'OnmyÅdÅ' },
  ]

  // Score by system count (systems array length)
  positives.forEach(p => { p.pts = p.systems.length * 7 + (c.score.breakdown.find(b=>b.system.includes(p.systems[0]?.split(' ')[0]))?.score||700)/100|0 })
  positives.sort((a,b) => b.pts - a.pts)

  return section(18, 'Activation Plan â€” 26 à¸¨à¸²à¸ªà¸•à¸£à¹Œà¹à¸™à¸°à¸™à¸³', 'ðŸš€', `
    <p style="font-size:11px;color:#7a6a52;margin-bottom:12px">
      à¹€à¸£à¸µà¸¢à¸‡à¸•à¸²à¸¡à¸ˆà¸³à¸™à¸§à¸™à¸¨à¸²à¸ªà¸•à¸£à¹Œà¸—à¸µà¹ˆà¹€à¸«à¹‡à¸™à¸žà¹‰à¸­à¸‡ â€” à¸—à¸³à¸—à¸µà¸¥à¸°à¸‚à¹‰à¸­ à¹„à¸¡à¹ˆà¸•à¹‰à¸­à¸‡à¸—à¸³à¸—à¸¸à¸à¸‚à¹‰à¸­à¸žà¸£à¹‰à¸­à¸¡à¸à¸±à¸™
    </p>

    <div style="font-size:13px;font-weight:600;color:#60c060;margin-bottom:8px">âœ… à¸ªà¸´à¹ˆà¸‡à¸—à¸µà¹ˆà¸„à¸§à¸£à¸—à¸³ (Positive Inputs)</div>
