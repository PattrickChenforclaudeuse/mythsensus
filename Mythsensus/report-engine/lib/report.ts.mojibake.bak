            <span style="font-size:11px;color:#60a060">${a.systems.length} à¸¨à¸²à¸ªà¸•à¸£à¹Œ</span>
          </div>
          <div style="font-size:11px;color:#9a8a72;margin-top:2px">${esc(a.body)}</div>
          <div style="font-size:10px;color:#5a7050;margin-top:2px">[${a.systems.slice(0,3).map(s=>esc(s.replace(/${.*?}/g,'...'))).join('] [')}]</div>
        </div>
      </div>`).join('')}

    <div style="font-size:13px;font-weight:600;color:#c05030;margin:14px 0 8px">ðŸš« à¸ªà¸´à¹ˆà¸‡à¸—à¸µà¹ˆà¸„à¸§à¸£à¸«à¸¥à¸µà¸à¹€à¸¥à¸µà¹ˆà¸¢à¸‡ (Negative Inputs)</div>
    ${negatives.map(n => `
      <div style="display:flex;gap:10px;padding:8px;border:1px solid #3a1510;border-radius:8px;margin:5px 0;background:#1a0a08">
        <span style="font-size:18px">${n.icon}</span>
