    </div>

    <!-- Warning signals -->
    ${warn.length > 0 ? `
    <div style="margin-bottom:14px">
      <div style="font-size:13px;color:#c05030;font-weight:600;margin-bottom:8px">âš ï¸ à¸£à¸°à¸§à¸±à¸‡ (${warn.length} à¸¨à¸²à¸ªà¸•à¸£à¹Œ)</div>
      ${warn.map(s => `
        <div style="display:flex;gap:8px;padding:6px 10px;background:#150a06;border-radius:6px;margin:4px 0;border-left:2px solid #8a3010">
