    </table>
    <p style="font-size:10px;color:#6a5a42;margin-top:6px">
      ðŸŒŸ Honmei (à¸”à¸²à¸§à¹€à¸à¸´à¸”à¸•à¸£à¸‡à¸à¸±à¸™) Â· ðŸŸ¢ NSK+Bio à¹€à¸ªà¸£à¸´à¸¡ Â· ðŸŸ¡ à¸à¸¥à¸²à¸‡ Â· ðŸ”´ NSK à¸‚à¸±à¸” Bio à¸•à¸ Â· à¸„à¸³à¸™à¸§à¸“à¹€à¸‰à¸žà¸²à¸°à¸”à¸§à¸‡à¸„à¸¸à¸“
    </p>
  `)
}

function p19_decade(c: ChartData): string {
  const currentAge = 2026 - c.input.year
  const lps = c.bazi.luckPillars
  const { vedicMahadasha, ninestar, numerology, biorhythm, tibetan } = c

  const decades = [
    { age:'25â€“34', label:'à¸§à¸±à¸¢à¸ªà¸£à¹‰à¸²à¸‡à¸£à¸²à¸à¸à¸²à¸™', advice:'à¸¥à¸‡à¸—à¸¸à¸™à¸—à¸±à¸à¸©à¸°à¹à¸¥à¸°à¹€à¸„à¸£à¸·à¸­à¸‚à¹ˆà¸²à¸¢' },
    { age:'35â€“44', label:'à¸§à¸±à¸¢à¸¥à¸‡à¸¡à¸·à¸­à¸ªà¸£à¹‰à¸²à¸‡', advice:'à¸‚à¸¢à¸²à¸¢à¸à¸´à¸ˆà¸à¸²à¸£à¹à¸¥à¸°à¸ªà¸£à¹‰à¸²à¸‡à¸Šà¸·à¹ˆà¸­à¹€à¸ªà¸µà¸¢à¸‡' },
    { age:'45â€“54', label:'à¸§à¸±à¸¢à¹€à¸à¹‡à¸šà¹€à¸à¸µà¹ˆà¸¢à¸§', advice:'harvest à¸œà¸¥à¹à¸¥à¸°à¸¥à¸‡à¸—à¸¸à¸™à¸£à¸°à¸¢à¸°à¸¢à¸²à¸§' },
    { age:'55â€“64', label:'à¸§à¸±à¸¢à¸–à¹ˆà¸²à¸¢à¸—à¸­à¸”', advice:'à¸ªà¸­à¸™à¹à¸¥à¸°à¸ªà¸£à¹‰à¸²à¸‡à¸¡à¸£à¸”à¸' },
    { age:'65+', label:'à¸§à¸±à¸¢à¸›à¸±à¸à¸à¸²', advice:'à¸ªà¸¸à¸‚à¸ à¸²à¸žà¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¸ªà¸‡à¸š' },
  ]

  return section(15, 'Decade by Decade â€” à¸¡à¸¸à¸¡à¸¡à¸­à¸‡ 5 à¸¨à¸²à¸ªà¸•à¸£à¹Œ', 'ðŸ“–', `
    ${decades.map((d, i) => {
      const ageStart = parseInt(d.age)
      const ageEnd = parseInt(d.age.split('â€“')[1] || '999')
      const lp = lps.find(lp => lp.ageEnd >= ageStart && lp.ageStart <= ageEnd) || lps[Math.min(i, lps.length-1)]
      const isNow = currentAge >= ageStart && currentAge <= ageEnd
      // NSK decade star
      const nskStar = ((9 - ((ageStart + c.input.year - 1 - 1) % 9)) % 9) + 1
      // PY pattern for decade start year
      const decadeStartYear = c.input.year + ageStart
      // Vedic: current dasha overlaps?
      const dashaOverlap = vedicMahadasha.currentDashaEnd >= decadeStartYear
      return `<div style="border:1px solid ${isNow?'#d4aa50':'#2a2010'};border-radius:8px;margin:8px 0;overflow:hidden">
        <div style="background:${isNow?'#1e1a0e':'#141210'};padding:10px 14px;display:flex;justify-content:space-between">
          <span style="font-weight:700;color:${isNow?'#d4aa50':'#9a8a72'}">${esc(d.age)} â€” ${esc(d.label)}</span>
          ${isNow?'<span style="color:#d4aa50;font-size:11px">â–¶ à¸¢à¸¸à¸„à¸›à¸±à¸ˆà¸ˆà¸¸à¸šà¸±à¸™</span>':''}
        </div>
        <div style="padding:10px 14px;font-size:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <div>ðŸ”¥ <strong>BaZi LP:</strong> ${esc(lp.stem)}${esc(lp.branch)} ${esc(lp.stemTh)} ${esc(lp.branchTh)}</div>
          <div>â­ <strong>NSK Decade:</strong> à¸”à¸²à¸§ ${nskStar} ${['','ä¸€ç™½','äºŒé»’','ä¸‰ç¢§','å››ç·‘','äº”é»„','å…­ç™½','ä¸ƒèµ¤','å…«ç™½','ä¹ç´«'][nskStar]||''}</div>
          <div>ðŸ•‰ï¸ <strong>Vedic:</strong> ${esc(vedicMahadasha.currentDasha)}${dashaOverlap?' (active)':' (next cycle)'}</div>
          <div>ðŸ”¢ <strong>Numerology PY:</strong> à¸›à¸µà¸—à¸µà¹ˆ ${ageStart} = PY${((decadeStartYear-1-c.input.year+1+c.input.month/12)%9)+1||9}</div>
          <div style="grid-column:span 2;color:#9a8a72;margin-top:4px">ðŸ’¡ ${esc(d.advice)}</div>
        </div>
      </div>`
    }).join('')}
    ${box('à¸Šà¹ˆà¸§à¸‡à¸—à¸­à¸‡à¹ƒà¸™à¸Šà¸µà¸§à¸´à¸•', `Luck Pillar ${c.bazi.currentLuckPillar} (${c.bazi.currentLuckPillarTh}) + NSK Star ${ninestar.star} ${ninestar.starChinese} + Vedic ${vedicMahadasha.currentDasha} Dasha â†’ 3 à¸¨à¸²à¸ªà¸•à¸£à¹Œà¸Šà¸µà¹‰à¸§à¹ˆà¸²à¸›à¸±à¸ˆà¸ˆà¸¸à¸šà¸±à¸™à¸„à¸·à¸­à¸Šà¹ˆà¸§à¸‡à¸ªà¸³à¸„à¸±à¸`, 'green')}
  `)
}

