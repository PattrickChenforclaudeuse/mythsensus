      <div style="font-size:16px;color:#f0e8d0;margin-top:4px">${esc(score.tier)}</div>
      <div style="font-size:12px;color:#9a8a72">${esc(score.percentile)} à¸‚à¸­à¸‡à¹‚à¸¥à¸</div>
