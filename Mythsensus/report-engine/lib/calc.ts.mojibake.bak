// â”€â”€ SAJU (Korean Four Pillars) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Same pillar system as BaZi; score emphasizes month-day harmony
function calcSaju(d: BirthData): SajuData {
  const KO_STEMS: Record<string,string> = {
    'ç”²':'ê°‘(ç”²)','ä¹™':'ì„(ä¹™)','ä¸™':'ë³‘(ä¸™)','ä¸':'ì •(ä¸)','æˆŠ':'ë¬´(æˆŠ)',
    'å·±':'ê¸°(å·±)','åºš':'ê²½(åºš)','è¾›':'ì‹ (è¾›)','å£¬':'ìž„(å£¬)','ç™¸':'ê³„(ç™¸)'
  };
  const KO_BRANCHES: Record<string,string> = {
    'å­':'ìž(å­)','ä¸‘':'ì¶•(ä¸‘)','å¯…':'ì¸(å¯…)','å¯':'ë¬˜(å¯)','è¾°':'ì§„(è¾°)','å·³':'ì‚¬(å·³)',
    'åˆ':'ì˜¤(åˆ)','æœª':'ë¯¸(æœª)','ç”³':'ì‹ (ç”³)','é…‰':'ìœ (é…‰)','æˆŒ':'ìˆ (æˆŒ)','äº¥':'í•´(äº¥)'
  };
  const dp = dayPillar(d.year, d.month, d.day);
  const mp = monthPillar(d.year, d.month, d.day);
  const yp = yearPillar(d.year, d.month, d.day);
  const hp_val = hourPillar(d.hour, dp.si);

  // Kwarsal (ê½ƒì‚´): auspicious annual fortune type based on day branch in current year
  const KWARSAL = ['í™”ê°œì‚´','ì²œì„ê·€ì¸','ì—­ë§ˆì‚´','ì§€ì‚´','ìž¬ì„±','ê´€ì„±','ì¸ì„±','ë¹„ê²','ì‹ìƒ','ìƒê´€','ìž¬ì„±','ì—­ë§ˆì‚´'];
  const kwarsal = KWARSAL[(dp.bi + (2026 % 12)) % 12];

  // Score: month-day compatibility (Saju emphasizes month stem heavily)
  const dmEl = STEMS_EL[dp.si];
  const monthEl = STEMS_EL[mp.si % 10];
  // ìƒì¡°(ç”ŸåŠ©): month feeds day master = excellent
  const SHENG_EL: Record<string,string> = {Wood:'Fire',Fire:'Earth',Earth:'Metal',Metal:'Water',Water:'Wood'};
  const EL_MAP: Record<string,string> = {'à¹„à¸¡à¹‰':'Wood','à¹„à¸Ÿ':'Fire','à¸”à¸´à¸™':'Earth','à¹‚à¸¥à¸«à¸°':'Metal','à¸™à¹‰à¸³':'Water'};
  const dmElEn = EL_MAP[dmEl] ?? 'Fire';
  const moElEn = EL_MAP[monthEl] ?? 'Wood';
  const feeds = SHENG_EL[moElEn] === dmElEn;
  const same = moElEn === dmElEn;
  const seed = (d.year * 7 + d.month * 17 + d.day * 11) % 120;
  const base = feeds ? 740 : same ? 700 : 660;
  const score = Math.max(450, Math.min(950, base + seed - 60));

  return {
    yearPillar: `${KO_STEMS[yp.stem]??yp.stem}${KO_BRANCHES[yp.branch]??yp.branch}`,
    monthPillar: `${KO_STEMS[mp.stem]??mp.stem}${KO_BRANCHES[mp.branch]??mp.branch}`,
    dayPillar: `${KO_STEMS[dp.stem]??dp.stem}${KO_BRANCHES[dp.branch]??dp.branch}`,
    hourPillar: `${KO_STEMS[hp_val.stem]??hp_val.stem}${KO_BRANCHES[hp_val.branch]??hp_val.branch}`,
    sajuElement: dmEl, kwarsal, dominantEnergy: feeds ? 'ìƒì¡° â€” à¹€à¸”à¸·à¸­à¸™à¸«à¸™à¸¸à¸™à¸§à¸±à¸™' : same ? 'ë¹„ê² â€” à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¹€à¸”à¸µà¸¢à¸§à¸à¸±à¸™' : 'ê·¹ â€” à¹à¸£à¸‡à¸à¸”à¸”à¸±à¸™',
    score,
    reading: `ì‚¬ì£¼ ${KO_STEMS[dp.stem]??dp.stem}${KO_BRANCHES[dp.branch]??dp.branch}ì¼ì£¼ â€” à¸˜à¸²à¸•à¸¸${dmEl}à¹€à¸›à¹‡à¸™à¸«à¸¥à¸±à¸ à¹€à¸”à¸·à¸­à¸™${feeds?'à¸«à¸™à¸¸à¸™':'à¸à¸”'}à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¸§à¸±à¸™ ${kwarsal}à¸šà¹ˆà¸‡à¸–à¸¶à¸‡à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¹ƒà¸™à¸›à¸µ 2026`,
  };
}

// â”€â”€ TIBETAN ASTROLOGY (Mewa & Parkha) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcTibetan(d: BirthData): TibetanData {
  const MEWA_NAMES = ['','à¸™à¹‰à¸³à¸‚à¸²à¸§','à¸”à¸´à¸™à¸”à¸³','à¹„à¸¡à¹‰à¹€à¸‚à¸µà¸¢à¸§','à¹„à¸¡à¹‰à¹€à¸‚à¸µà¸¢à¸§','à¸”à¸´à¸™à¹€à¸«à¸¥à¸·à¸­à¸‡','à¹‚à¸¥à¸«à¸°à¸‚à¸²à¸§','à¹‚à¸¥à¸«à¸°à¹à¸”à¸‡','à¸”à¸´à¸™à¸‚à¸²à¸§','à¹„à¸Ÿà¸¡à¹ˆà¸§à¸‡'];
  const MEWA_EL = ['','à¸™à¹‰à¸³','à¸”à¸´à¸™','à¹„à¸¡à¹‰','à¹„à¸¡à¹‰','à¸”à¸´à¸™','à¹‚à¸¥à¸«à¸°','à¹‚à¸¥à¸«à¸°','à¸”à¸´à¸™','à¹„à¸Ÿ'];
  const MEWA_QUALITY = ['','à¸ªà¸¡à¸”à¸¸à¸¥','à¸—à¹‰à¸²à¸—à¸²à¸¢','à¹€à¸•à¸´à¸šà¹‚à¸•','à¹€à¸ªà¸£à¸´à¸¡','à¸—à¹‰à¸²à¸—à¸²à¸¢à¸¡à¸²à¸','à¸¡à¸±à¹ˆà¸™à¸„à¸‡','à¸à¸¥à¹‰à¸²à¸«à¸²à¸','à¹€à¸‚à¹‰à¸¡à¹à¸‚à¹‡à¸‡','à¸£à¸¸à¹ˆà¸‡à¹€à¸£à¸·à¸­à¸‡'];
  const MEWA_QUALITY_SCORE = [0,700,580,730,720,560,750,720,760,800];

  // Mewa: birth year mewa (counting backwards from 9)
  const adjYear = (d.month < 2 || (d.month === 2 && d.day < 4)) ? d.year - 1 : d.year;
  const mewa = ((9 - ((adjYear - 1) % 9)) % 9) + 1; // Tibetan counts opposite to 9 Star Ki

  // Parkha: 8 trigrams cycled by year
  const PARKHA = ['Khen','Zin','Kham','Zon','Khy','Dha','Gin','Li'];
  const PARKHA_EL = ['à¹‚à¸¥à¸«à¸°','à¸”à¸´à¸™','à¸”à¸´à¸™','à¹„à¸¡à¹‰','à¹„à¸¡à¹‰','à¸™à¹‰à¸³','à¹„à¸Ÿ','à¹„à¸Ÿ'];
  const PARKHA_NAMES = ['Khen (à¸Ÿà¹‰à¸²)','Zin (à¸”à¸´à¸™)','Kham (à¸™à¹‰à¸³)','Zon (à¸ªà¸²à¸¢à¸Ÿà¹‰à¸²)','Khy (à¸¥à¸¡)','Dha (à¸—à¸°à¹€à¸¥)','Gin (à¸ à¸¹à¹€à¸‚à¸²)','Li (à¹„à¸Ÿ)'];
  const parkhaIdx = ((adjYear - 1) % 8 + 8) % 8;

  const baseScore = MEWA_QUALITY_SCORE[mewa] ?? 700;
  const variation = (d.day * 3 + d.month * 7) % 80 - 40;
  const score = Math.max(420, Math.min(950, baseScore + variation));

  return {
    mewa, mewaName: `Mewa ${mewa} â€” ${MEWA_NAMES[mewa]}`, mewaElement: MEWA_EL[mewa],
    mewaQuality: MEWA_QUALITY[mewa],
    parkha: PARKHA[parkhaIdx], parkhaElement: PARKHA_EL[parkhaIdx], parkhaName: PARKHA_NAMES[parkhaIdx],
    score,
    reading: `Mewa ${mewa} (${MEWA_NAMES[mewa]}) â€” ${MEWA_QUALITY[mewa]} | Parkha ${PARKHA_NAMES[parkhaIdx]} à¸˜à¸²à¸•à¸¸${PARKHA_EL[parkhaIdx]} à¸•à¸²à¸¡à¹‚à¸«à¸£à¸²à¸¨à¸²à¸ªà¸•à¸£à¹Œà¸—à¸´à¹€à¸šà¸• à¸›à¸µà¹€à¸à¸´à¸”à¸¡à¸µà¸žà¸¥à¸±à¸‡${MEWA_EL[mewa]}à¹€à¸›à¹‡à¸™à¸£à¸²à¸à¸à¸²à¸™`,
  };
}

// â”€â”€ ZI WEI DOU SHU (ç´«å¾®æ–—æ•¸) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcZiWei(d: BirthData): ZiWeiData {
  // Simplified: Zi Wei (Purple Star) palace determined by birth month + day
  const PALACES_TH = ['','à¸Šà¸µà¸§à¸´à¸• (å‘½å®®)','à¸ªà¸µà¹ˆà¹€à¸«à¸¥à¸µà¹ˆà¸¢à¸¡ (å…„å¼Ÿ)','à¸ªà¸²à¸¡à¸µ/à¸ à¸£à¸£à¸¢à¸² (å¤«å¦»)','à¸šà¸¸à¸•à¸£ (å­å¥³)','à¸„à¸™à¹ƒà¸™à¸„à¸£à¸­à¸šà¸„à¸£à¸±à¸§ (è²¡å¸›)','à¸ªà¸¸à¸‚à¸ à¸²à¸ž (ç–¾åŽ„)','à¸à¸²à¸£à¹€à¸”à¸´à¸™à¸—à¸²à¸‡ (é·ç§»)','à¹€à¸žà¸·à¹ˆà¸­à¸™ (äº¤å‹)','à¸§à¸´à¸Šà¸²à¸Šà¸µà¸ž (å®˜ç¥¿)','à¸­à¸ªà¸±à¸‡à¸«à¸² (ç”°å®…)','à¹‚à¸Šà¸„à¸Šà¸°à¸•à¸² (ç¦å¾·)','à¸žà¹ˆà¸­à¹à¸¡à¹ˆ (çˆ¶æ¯)'];
  const STAR_MAP: Record<number,{star:string;starTh:string;quality:string;baseScore:number}> = {
    1: {star:'ç´«å¾®',starTh:'à¸”à¸²à¸§à¸¡à¹ˆà¸§à¸‡à¸ˆà¸±à¸à¸£à¸žà¸£à¸£à¸”à¸´',quality:'à¸™à¸³à¹‚à¸Šà¸„à¸ªà¸¹à¸‡',baseScore:820},
    2: {star:'å¤©æ©Ÿ',starTh:'à¸”à¸²à¸§à¸›à¸±à¸à¸à¸²',quality:'à¸ªà¸•à¸´à¸›à¸±à¸à¸à¸²à¹à¸¥à¸°à¸à¸¥à¸¢à¸¸à¸—à¸˜',baseScore:760},
    3: {star:'å¤ªé™½',starTh:'à¸”à¸²à¸§à¸žà¸£à¸°à¸­à¸²à¸—à¸´à¸•à¸¢à¹Œ',quality:'à¸Šà¸·à¹ˆà¸­à¹€à¸ªà¸µà¸¢à¸‡à¹à¸¥à¸°à¸­à¸³à¸™à¸²à¸ˆ',baseScore:790},
    4: {star:'æ­¦æ›²',starTh:'à¸”à¸²à¸§à¹‚à¸¥à¸«à¸°à¹à¸à¸£à¹ˆà¸‡',quality:'à¸¡à¸±à¹ˆà¸‡à¸„à¸±à¹ˆà¸‡à¹à¸¥à¸°à¸à¸¥à¹‰à¸²à¸«à¸²à¸',baseScore:770},
    5: {star:'å¤©åŒ',starTh:'à¸”à¸²à¸§à¸ªà¸§à¸£à¸£à¸„à¹Œà¸ªà¸¡à¸”à¸¸à¸¥',quality:'à¸„à¸§à¸²à¸¡à¸ªà¸¸à¸‚à¹à¸¥à¸°à¸¨à¸´à¸¥à¸›à¸°',baseScore:740},
    6: {star:'å»‰è²ž',starTh:'à¸”à¸²à¸§à¸¨à¸±à¸à¸”à¸´à¹Œà¸¨à¸£à¸µ',quality:'à¸„à¸§à¸²à¸¡à¸‹à¸·à¹ˆà¸­à¸ªà¸±à¸•à¸¢à¹Œ',baseScore:730},
    7: {star:'å¤©åºœ',starTh:'à¸”à¸²à¸§à¸„à¸¥à¸±à¸‡à¸ªà¸¡à¸šà¸±à¸•à¸´',quality:'à¸„à¸§à¸²à¸¡à¸¡à¸±à¹ˆà¸‡à¸„à¸±à¹ˆà¸‡à¸ªà¸°à¸ªà¸¡',baseScore:800},
    8: {star:'å¤ªé™°',starTh:'à¸”à¸²à¸§à¸žà¸£à¸°à¸ˆà¸±à¸™à¸—à¸£à¹Œ',quality:'à¸„à¸§à¸²à¸¡à¸‡à¸²à¸¡à¹à¸¥à¸°à¸ªà¸±à¸à¸Šà¸²à¸•à¸à¸²à¸“',baseScore:755},
    9: {star:'è²ªç‹¼',starTh:'à¸”à¸²à¸§à¸«à¸¡à¸²à¸›à¹ˆà¸²',quality:'à¸„à¸§à¸²à¸¡à¸›à¸£à¸²à¸£à¸–à¸™à¸²à¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¹€à¸›à¹‡à¸™à¹€à¸ˆà¹‰à¸²',baseScore:720},
    10:{star:'å·¨é–€',starTh:'à¸”à¸²à¸§à¸›à¸£à¸°à¸•à¸¹à¸¢à¸±à¸à¸©à¹Œ',quality:'à¸›à¸²à¸à¸à¸¥à¹‰à¸²à¹à¸¥à¸°à¸ªà¸·à¹ˆà¸­à¸ªà¸²à¸£',baseScore:700},
    11:{star:'å¤©ç›¸',starTh:'à¸”à¸²à¸§à¸¡à¸™à¸•à¸£à¸µ',quality:'à¸—à¸µà¹ˆà¸›à¸£à¸¶à¸à¸©à¸²à¸œà¸¹à¹‰à¸”à¸µ',baseScore:740},
    12:{star:'å¤©æ¢',starTh:'à¸”à¸²à¸§à¸„à¸²à¸™à¸Ÿà¹‰à¸²',quality:'à¸à¸¸à¸¨à¸¥à¹à¸¥à¸°à¸à¸²à¸£à¸Šà¹ˆà¸§à¸¢à¹€à¸«à¸¥à¸·à¸­',baseScore:750},
  };
  // Life palace: birth month determines starting palace, day determines Zi Wei position
  const lifepalace = ((d.month * 2 + d.day) % 12) + 1;
  const starIdx = ((d.month + d.day * 2) % 12) + 1;
  const star = STAR_MAP[starIdx] ?? STAR_MAP[1];
  const variation = (d.year % 100 + d.hour * 3) % 60 - 30;
  const score = Math.max(420, Math.min(960, star.baseScore + variation));

  return {
    lifepalace, lifePalaceName: PALACES_TH[lifepalace] ?? 'à¸Šà¸µà¸§à¸´à¸•',
    mainStar: star.star, mainStarTh: star.starTh, palaceQuality: star.quality,
    score,
    reading: `ç´«å¾®æ–—æ•¸: à¸§à¸±à¸‡à¸Šà¸µà¸§à¸´à¸•à¸—à¸µà¹ˆ ${PALACES_TH[lifepalace]??'à¸Šà¸µà¸§à¸´à¸•'} à¸¡à¸µà¸”à¸²à¸§à¸«à¸¥à¸±à¸${star.starTh} (${star.star}) â€” ${star.quality} à¸„à¸¸à¸“à¸ à¸²à¸žà¸”à¸§à¸‡à¸Šà¸°à¸•à¸²: ${star.quality}`,
  };
}

// â”€â”€ ONMYÅŒDÅŒ (é™°é™½é“) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcOnmyodo(d: BirthData): OnmyodoData {
  // Rokuyo (å…­æ›œ): (month + day) % 6 â€” birth day fortune
  const ROKUYO = [
    {name:'å¤§å®‰',th:'à¸¡à¸«à¸²à¸ªà¸´à¸£à¸´à¸¡à¸‡à¸„à¸¥',score:860},
    {name:'å‹å¼•',th:'à¸”à¸¶à¸‡à¹‚à¸Šà¸„à¹€à¸žà¸·à¹ˆà¸­à¸™',score:780},
    {name:'å…ˆå‹',th:'à¸Šà¸™à¸°à¹ƒà¸™à¹€à¸Šà¹‰à¸²',score:720},
    {name:'å…ˆè² ',th:'à¸Šà¸™à¸°à¹ƒà¸™à¹€à¸¢à¹‡à¸™',score:690},
    {name:'èµ¤å£',th:'à¸›à¸²à¸à¹à¸”à¸‡-à¸£à¸°à¸§à¸±à¸‡',score:620},
    {name:'ä»æ»…',th:'à¸žà¸£à¸°à¸žà¸¸à¸—à¸˜à¹€à¸ˆà¹‰à¸²à¸ªà¸´à¹‰à¸™-à¸£à¸°à¸§à¸±à¸‡',score:560},
  ];
  const JUSHI_NAKSHATRA = ['å­','ä¸‘','å¯…','å¯','è¾°','å·³','åˆ','æœª','ç”³','é…‰','æˆŒ','äº¥'];
  const rokuyoIdx = ((d.month + d.day) % 6 + 6) % 6;
  const rokuyo = ROKUYO[rokuyoIdx];
  // Onmyo polarity: Yang year = even last digit; birth hour determines secondary
  const isYang = d.year % 2 === 0;
  const variation = (d.day * 5 + d.month * 9) % 80 - 40;
  const score = Math.max(420, Math.min(950, rokuyo.score + variation));

  return {
    rokuyo: rokuyo.name, rokuyoTh: rokuyo.th, rokuyoScore: rokuyo.score,
    onmyoPolarity: isYang ? 'à¸«à¸¢à¸²à¸‡ (é™½)' : 'à¸«à¸¢à¸´à¸™ (é™°)',
    juniShiNakshatra: JUSHI_NAKSHATRA[d.month % 12],
    score,
    reading: `é™°é™½é“: à¸§à¸±à¸™à¹€à¸à¸´à¸”${rokuyo.name} (${rokuyo.th}) à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™${isYang?'à¸«à¸¢à¸²à¸‡':'à¸«à¸¢à¸´à¸™'} â€” à¹ƒà¸™à¹‚à¸«à¸£à¸²à¸¨à¸²à¸ªà¸•à¸£à¹Œà¸à¸µà¹ˆà¸›à¸¸à¹ˆà¸™ ${rokuyo.name}à¸šà¹ˆà¸‡à¸–à¸¶à¸‡${rokuyo.th} à¹€à¸›à¹‡à¸™à¸žà¸·à¹‰à¸™à¸à¸²à¸™à¸Šà¸°à¸•à¸²à¸Šà¸µà¸§à¸´à¸•`,
  };
}

// â”€â”€ HELLENISTIC ASTROLOGY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcHellenistic(d: BirthData): HellenisticData {
  // Sect: daytime birth (6:00-18:00) = day sect; favors Sun, Jupiter, Saturn
  const isDaySect = d.hour >= 6 && d.hour < 18;
  const sect = isDaySect ? 'Day Sect' : 'Night Sect';
  const sectTh = isDaySect ? 'à¹€à¸à¸´à¸”à¸à¸¥à¸²à¸‡à¸§à¸±à¸™ â€” Sun/Jupiter/Saturn à¸«à¸™à¸¸à¸™' : 'à¹€à¸à¸´à¸”à¸à¸¥à¸²à¸‡à¸„à¸·à¸™ â€” Moon/Venus/Mars à¸«à¸™à¸¸à¸™';
  const trigonLord = isDaySect ? 'Jupiter (à¸à¸²à¸£à¸‚à¸¢à¸²à¸¢à¸•à¸±à¸§)' : 'Venus (à¸„à¸§à¸²à¸¡à¸ªà¸±à¸¡à¸žà¸±à¸™à¸˜à¹Œ)';

  // Lot of Fortune: ASC + Moon - Sun (day) or ASC + Sun - Moon (night)
  // Use simplified: derive from birth data
  const ASC_DEG = (d.lat * 2 + d.hour * 15 + d.minute / 4) % 360;
  const sunDeg = ((d.month - 1) * 30 + (d.day - 1)) % 360;
  const moonDeg = ((d.year * 13 + d.month * 7 + d.day * 3 + d.hour) % 360);
  const lotRaw = isDaySect
    ? (ASC_DEG + moonDeg - sunDeg + 360) % 360
    : (ASC_DEG + sunDeg - moonDeg + 360) % 360;
  const lotSign = Math.floor(lotRaw / 30); // 0-11
  const SIGNS_TH = ['à¹€à¸¡à¸©','à¸žà¸¤à¸©à¸ ','à¹€à¸¡à¸–à¸¸à¸™','à¸à¸£à¸à¸Ž','à¸ªà¸´à¸‡à¸«à¹Œ','à¸à¸±à¸™à¸¢à¹Œ','à¸•à¸¸à¸¥à¸¢à¹Œ','à¸žà¸´à¸ˆà¸´à¸','à¸˜à¸™à¸¹','à¸¡à¸à¸£','à¸à¸¸à¸¡à¸ à¹Œ','à¸¡à¸µà¸™'];
  const SIGN_SCORES = [750,780,760,700,800,720,770,710,790,730,760,720]; // fortune by sign

  const sectBonus = isDaySect ? 30 : 20;
  const variation = (d.day * 7 + d.month * 5) % 60 - 30;
  const score = Math.max(440, Math.min(950, SIGN_SCORES[lotSign] + sectBonus + variation));

  return {
    sect, sectTh, trigonLord,
    lotOfFortune: Math.round(lotRaw), lotSign: SIGNS_TH[lotSign], lotSignTh: SIGNS_TH[lotSign],
    score,
    reading: `Hellenistic: ${sectTh} â€” à¹€à¸ˆà¹‰à¸²à¸Šà¸µà¸§à¸´à¸•à¸„à¸·à¸­${trigonLord} | Lot of Fortune à¸­à¸¢à¸¹à¹ˆà¹ƒà¸™${SIGNS_TH[lotSign]} (${Math.round(lotRaw)}Â°) à¸šà¹ˆà¸‡à¸–à¸¶à¸‡à¹‚à¸Šà¸„à¸Šà¸°à¸•à¸²à¸”à¹‰à¸²à¸™à¹‚à¸¥à¸à¸§à¸±à¸•à¸–à¸¸`,
  };
}

// â”€â”€ NORSE RUNE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcNorseRune(d: BirthData): NorseRuneData {
  // Elder Futhark 24 runes; birth date â†’ rune via day-of-year
  const doy = Math.floor((new Date(d.year, d.month-1, d.day).getTime() - new Date(d.year,0,0).getTime()) / 86400000);
  const runeIdx = Math.floor((doy - 1) / (365/24)) % 24;
  const RUNES = [
    {r:'áš ',n:'Fehu',th:'à¹‚à¸Šà¸„à¸¥à¸²à¸ ',el:'à¹„à¸Ÿ',kw:'à¸„à¸§à¸²à¸¡à¸¡à¸±à¹ˆà¸‡à¸„à¸±à¹ˆà¸‡',score:800},
    {r:'áš¢',n:'Uruz',th:'à¸à¸£à¸°à¸—à¸´à¸‡',el:'à¸”à¸´à¸™',kw:'à¸„à¸§à¸²à¸¡à¹à¸‚à¹‡à¸‡à¹à¸à¸£à¹ˆà¸‡',score:780},
    {r:'áš¦',n:'Thurisaz',th:'à¸«à¸™à¸²à¸¡',el:'à¹„à¸Ÿ',kw:'à¸„à¸§à¸²à¸¡à¸—à¹‰à¸²à¸—à¸²à¸¢',score:650},
    {r:'áš¨',n:'Ansuz',th:'à¹€à¸—à¸žà¸§à¸²à¸ˆà¸²',el:'à¸¥à¸¡',kw:'à¸›à¸±à¸à¸à¸²à¹à¸¥à¸°à¸ªà¸²à¸£',score:790},
