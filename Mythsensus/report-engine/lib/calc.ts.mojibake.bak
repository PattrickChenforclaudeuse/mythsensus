    {r:'ášº',n:'Hagalaz',th:'à¸¥à¸¹à¸à¹€à¸«à¹‡à¸š',el:'à¸™à¹‰à¸³',kw:'à¸à¸²à¸£à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¹à¸›à¸¥à¸‡',score:600},
    {r:'áš¾',n:'Nauthiz',th:'à¸„à¸§à¸²à¸¡à¸ˆà¸³à¹€à¸›à¹‡à¸™',el:'à¹„à¸Ÿ',kw:'à¸à¸²à¸£à¹€à¸­à¸²à¸Šà¸µà¸§à¸´à¸•à¸£à¸­à¸”',score:640},
    {r:'á›',n:'Isa',th:'à¸™à¹‰à¸³à¹à¸‚à¹‡à¸‡',el:'à¸™à¹‰à¸³',kw:'à¸à¸²à¸£à¸«à¸¢à¸¸à¸”à¸™à¸´à¹ˆà¸‡',score:580},
    {r:'á›ƒ',n:'Jera',th:'à¸à¸²à¸£à¹€à¸à¹‡à¸šà¹€à¸à¸µà¹ˆà¸¢à¸§',el:'à¸”à¸´à¸™',kw:'à¸£à¸²à¸‡à¸§à¸±à¸¥à¹à¸«à¹ˆà¸‡à¹à¸£à¸‡à¸‡à¸²à¸™',score:790},
    {r:'á›‡',n:'Eihwaz',th:'à¸•à¹‰à¸™à¸¢à¸¹à¸§à¹Œ',el:'à¸”à¸´à¸™',kw:'à¸„à¸§à¸²à¸¡à¸­à¸”à¸—à¸™',score:720},
    {r:'á›ˆ',n:'Perthro',th:'à¸–à¹‰à¸§à¸¢à¸Šà¸°à¸•à¸²',el:'à¸™à¹‰à¸³',kw:'à¸¥à¸¶à¸à¸¥à¸±à¸šà¹à¸¥à¸°à¹‚à¸Šà¸„',score:730},
    {r:'á›‰',n:'Algiz',th:'à¸à¸§à¸²à¸‡',el:'à¸¥à¸¡',kw:'à¸à¸²à¸£à¸›à¸à¸›à¹‰à¸­à¸‡',score:770},
    {r:'á›Š',n:'Sowilo',th:'à¸žà¸£à¸°à¸­à¸²à¸—à¸´à¸•à¸¢à¹Œ',el:'à¹„à¸Ÿ',kw:'à¸Šà¸±à¸¢à¸Šà¸™à¸°',score:830},
    {r:'á›',n:'Tiwaz',th:'à¹€à¸—à¸žà¸ªà¸‡à¸„à¸£à¸²à¸¡',el:'à¸¥à¸¡',kw:'à¸„à¸§à¸²à¸¡à¸à¸¥à¹‰à¸²à¸«à¸²à¸',score:800},
    {r:'á›’',n:'Berkano',th:'à¸•à¹‰à¸™à¹€à¸šà¸´à¸£à¹Œà¸Š',el:'à¸”à¸´à¸™',kw:'à¸à¸²à¸£à¹€à¸à¸´à¸”à¹ƒà¸«à¸¡à¹ˆ',score:760},
    {r:'á›–',n:'Ehwaz',th:'à¸¡à¹‰à¸²',el:'à¸”à¸´à¸™',kw:'à¸à¸²à¸£à¹€à¸”à¸´à¸™à¸—à¸²à¸‡',score:750},
    {r:'á›—',n:'Mannaz',th:'à¸¡à¸™à¸¸à¸©à¸¢à¹Œ',el:'à¸¥à¸¡',kw:'à¸•à¸±à¸§à¸•à¸™à¹à¸¥à¸°à¸Šà¸¸à¸¡à¸Šà¸™',score:740},
    {r:'á›š',n:'Laguz',th:'à¸™à¹‰à¸³',el:'à¸™à¹‰à¸³',kw:'à¸„à¸§à¸²à¸¡à¸£à¸¹à¹‰à¸ªà¸¶à¸à¸¥à¸¶à¸',score:710},
    {r:'á›œ',n:'Ingwaz',th:'à¹€à¸—à¸žà¹à¸«à¹ˆà¸‡à¸žà¸·à¹‰à¸™à¸”à¸´à¸™',el:'à¸”à¸´à¸™',kw:'à¸¨à¸±à¸à¸¢à¸ à¸²à¸ž',score:760},
    {r:'á›ž',n:'Dagaz',th:'å¤œæ˜Ž',el:'à¹„à¸Ÿ',kw:'à¸à¸²à¸£à¸•à¸·à¹ˆà¸™à¸£à¸¹à¹‰',score:810},
    {r:'á›Ÿ',n:'Othalan',th:'à¸¡à¸£à¸”à¸',el:'à¸”à¸´à¸™',kw:'à¸£à¸²à¸à¹à¸¥à¸°à¸¡à¸£à¸”à¸',score:740},
  ];
  const rune = RUNES[runeIdx] ?? RUNES[0];
  const variation = (d.day * 11 + d.month * 7) % 60 - 30;
  const score = Math.max(430, Math.min(940, rune.score + variation));
  return {
    rune: rune.r, runeName: rune.n, runeNameTh: rune.th,
    runeElement: rune.el, runeKeyword: rune.kw,
    score,
    reading: `Norse Rune: ${rune.r} ${rune.n} (${rune.th}) â€” ${rune.kw} à¸˜à¸²à¸•à¸¸${rune.el} à¸£à¸¹à¸™à¹à¸«à¹ˆà¸‡à¸Šà¸µà¸§à¸´à¸•à¸šà¹ˆà¸‡à¸–à¸¶à¸‡à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™${rune.kw}à¹€à¸›à¹‡à¸™à¸žà¸·à¹‰à¸™à¸à¸²à¸™`,
  };
}

// â”€â”€ OGHAM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcOgham(d: BirthData): OghamData {
  // Beth-Luis-Nion calendar: 13 months + 1 day, based on birth date
  const OGHAM = [
    {o:'áš',tree:'Birch',th:'à¹€à¸šà¸´à¸£à¹Œà¸Š',cls:'à¸•à¹‰à¸™à¹ƒà¸«à¸¡à¹ˆ',el:'à¸™à¹‰à¸³',score:750},
    {o:'áš‚',tree:'Rowan',th:'à¹‚à¸£à¸§à¸±à¸™',cls:'à¸•à¹‰à¸™à¸›à¸à¸›à¹‰à¸­à¸‡',el:'à¹„à¸Ÿ',score:790},
    {o:'ášƒ',tree:'Ash',th:'à¹à¸­à¸Š',cls:'à¸•à¹‰à¸™à¹€à¸Šà¸·à¹ˆà¸­à¸¡à¹‚à¸¢à¸‡',el:'à¸¥à¸¡',score:770},
    {o:'áš„',tree:'Alder',th:'à¸­à¸±à¸¥à¹€à¸”à¸­à¸£à¹Œ',cls:'à¸•à¹‰à¸™à¸œà¸¹à¹‰à¸™à¸³',el:'à¹„à¸Ÿ',score:760},
    {o:'áš…',tree:'Willow',th:'à¸§à¸´à¸¥à¹‚à¸¥à¸§à¹Œ',cls:'à¸•à¹‰à¸™à¸ˆà¸±à¸™à¸—à¸£à¹Œ',el:'à¸™à¹‰à¸³',score:720},
    {o:'áš†',tree:'Hawthorn',th:'à¸®à¸­à¸§à¹Œà¸˜à¸­à¸£à¹Œà¸™',cls:'à¸•à¹‰à¸™à¸­à¸¸à¸›à¸ªà¸£à¸£à¸„',el:'à¹„à¸Ÿ',score:640},
    {o:'áš‡',tree:'Oak',th:'à¹‚à¸­à¹Šà¸',cls:'à¸•à¹‰à¸™à¸à¸©à¸±à¸•à¸£à¸´à¸¢à¹Œ',el:'à¸”à¸´à¸™',score:820},
    {o:'ášˆ',tree:'Holly',th:'à¸®à¸­à¸¥à¸¥à¸µà¹ˆ',cls:'à¸•à¹‰à¸™à¸™à¸±à¸à¸£à¸š',el:'à¹„à¸Ÿ',score:760},
    {o:'áš‰',tree:'Hazel',th:'à¹€à¸®à¹€à¸‹à¸¥',cls:'à¸•à¹‰à¸™à¸›à¸±à¸à¸à¸²',el:'à¸¥à¸¡',score:800},
    {o:'ášŠ',tree:'Vine',th:'à¹€à¸–à¸²à¸­à¸‡à¸¸à¹ˆà¸™',cls:'à¸•à¹‰à¸™à¸¡à¸µà¸ªà¸§à¸£à¸£à¸„à¹Œ',el:'à¸™à¹‰à¸³',score:740},
    {o:'áš‹',tree:'Ivy',th:'à¹„à¸­à¸§à¸µà¹ˆ',cls:'à¸•à¹‰à¸™à¸œà¸¹à¹‰à¹à¸ªà¸§à¸‡à¸«à¸²',el:'à¸™à¹‰à¸³',score:710},
    {o:'ášŒ',tree:'Reed',th:'à¸à¸',cls:'à¸•à¹‰à¸™à¸œà¸¹à¹‰à¸ªà¹ˆà¸‡à¸ªà¸²à¸£',el:'à¸¥à¸¡',score:730},
    {o:'áš',tree:'Blackthorn',th:'à¹à¸šà¸¥à¹‡à¸„à¸˜à¸­à¸£à¹Œà¸™',cls:'à¸•à¹‰à¸™à¹€à¸§à¸—à¸¡à¸™à¸•à¸£à¹Œ',el:'à¸”à¸´à¸™',score:650},
  ];
  const oghamIdx = ((d.month - 1) + Math.floor(d.day / 28)) % 13;
  const og = OGHAM[oghamIdx];
  const variation = (d.year % 100 + d.day * 3) % 60 - 30;
  const score = Math.max(430, Math.min(940, og.score + variation));
  return {
    ogham: og.o, treeName: og.tree, treeNameTh: og.th,
    oghamClass: og.cls, element: og.el,
    score,
    reading: `Ogham: ${og.o} ${og.tree} (${og.th}) â€” ${og.cls} à¸˜à¸²à¸•à¸¸${og.el} à¸•à¹‰à¸™à¹„à¸¡à¹‰à¸¨à¸±à¸à¸”à¸´à¹Œà¸ªà¸´à¸—à¸˜à¸´à¹Œà¹„à¸­à¸£à¸´à¸Š${og.cls}à¸«à¸™à¸¸à¸™à¸Šà¸°à¸•à¸²`,
  };
}

// â”€â”€ ARABIC PARTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcArabicParts(d: BirthData): ArabicPartsData {
  const SIGNS_TH = ['à¹€à¸¡à¸©','à¸žà¸¤à¸©à¸ ','à¹€à¸¡à¸–à¸¸à¸™','à¸à¸£à¸à¸Ž','à¸ªà¸´à¸‡à¸«à¹Œ','à¸à¸±à¸™à¸¢à¹Œ','à¸•à¸¸à¸¥à¸¢à¹Œ','à¸žà¸´à¸ˆà¸´à¸','à¸˜à¸™à¸¹','à¸¡à¸à¸£','à¸à¸¸à¸¡à¸ à¹Œ','à¸¡à¸µà¸™'];
  const SIGN_SCORES = [760,800,750,710,820,730,780,720,800,740,760,730];
  const isDaySect = d.hour >= 6 && d.hour < 18;
  const ASC = (d.lat * 2 + d.hour * 15 + d.minute / 4) % 360;
  const sun = ((d.month - 1) * 30 + d.day) % 360;
  const moon = ((d.year * 13 + d.month * 7 + d.day * 3) % 360);
  const fortune = isDaySect ? (ASC + moon - sun + 360) % 360 : (ASC + sun - moon + 360) % 360;
  const spirit = isDaySect ? (ASC + sun - moon + 360) % 360 : (ASC + moon - sun + 360) % 360;
  const fSign = Math.floor(fortune / 30);
  const sSign = Math.floor(spirit / 30);
  const variation = (d.day * 9 + d.month * 3) % 60 - 30;
  const score = Math.max(440, Math.min(950, SIGN_SCORES[fSign] + variation));
  return {
    partOfFortune: Math.round(fortune), fortuneSign: SIGNS_TH[fSign], fortuneSignTh: SIGNS_TH[fSign],
    partOfSpirit: Math.round(spirit), spiritSign: SIGNS_TH[sSign],
    score,
    reading: `Arabic Parts: Lot of Fortune ${Math.round(fortune)}Â° à¹ƒà¸™${SIGNS_TH[fSign]} | Lot of Spirit à¹ƒà¸™${SIGNS_TH[sSign]} â€” à¸•à¸²à¸¡à¹‚à¸«à¸£à¸²à¸¨à¸²à¸ªà¸•à¸£à¹Œà¹€à¸®à¸¥à¹€à¸¥à¸™à¸´à¸ªà¸•à¸´à¸ Part of Fortune à¸Šà¸µà¹‰à¸—à¸´à¸¨à¸—à¸²à¸‡à¹‚à¸Šà¸„à¸Šà¸°à¸•à¸²à¸—à¸²à¸‡à¸§à¸±à¸•à¸–à¸¸`,
  };
}

// â”€â”€ KABBALISTIC â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcKabbalistic(d: BirthData): KabbalisticData {
  const SEPHIROT = [
    {n:'Keter',heb:'×›Ö¶Ö¼×ªÖ¶×¨',arch:'Metatron',score:820,th:'à¸¡à¸‡à¸à¸¸à¸Ž â€” à¸„à¸§à¸²à¸¡à¸¨à¸±à¸à¸”à¸´à¹Œà¸ªà¸´à¸—à¸˜à¸´à¹Œà¸ªà¸¹à¸‡à¸ªà¸¸à¸”'},
    {n:'Chokmah',heb:'×—Ö¸×›Ö°×žÖ¸×”',arch:'Raziel',score:800,th:'à¸›à¸±à¸à¸à¸² â€” à¹à¸£à¸‡à¸šà¸±à¸™à¸”à¸²à¸¥à¹ƒà¸ˆà¸ˆà¸±à¸à¸£à¸§à¸²à¸¥'},
    {n:'Binah',heb:'×‘Ö´Ö¼×™× Ö¸×”',arch:'Tzaphkiel',score:780,th:'à¸„à¸§à¸²à¸¡à¹€à¸‚à¹‰à¸²à¹ƒà¸ˆ â€” à¸„à¸§à¸²à¸¡à¸¥à¸¶à¸à¸‚à¸­à¸‡à¸ˆà¸´à¸•à¹ƒà¸ˆ'},
    {n:'Chesed',heb:'×—Ö¶×¡Ö¶×“',arch:'Tzadkiel',score:790,th:'à¹€à¸¡à¸•à¸•à¸² â€” à¸„à¸§à¸²à¸¡à¸­à¸¸à¸”à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œ'},
    {n:'Geburah',heb:'×’Ö°Ö¼×‘×•Ö¼×¨Ö¸×”',arch:'Camael',score:740,th:'à¸„à¸§à¸²à¸¡à¹€à¸‚à¹‰à¸¡à¹à¸‚à¹‡à¸‡ â€” à¸§à¸´à¸™à¸±à¸¢à¹à¸¥à¸°à¸­à¸³à¸™à¸²à¸ˆ'},
    {n:'Tiphareth',heb:'×ªÖ´Ö¼×¤Ö°×Ö¶×¨Ö¶×ª',arch:'Michael',score:810,th:'à¸„à¸§à¸²à¸¡à¸ªà¸§à¸¢à¸‡à¸²à¸¡ â€” à¸„à¸§à¸²à¸¡à¸ªà¸¡à¸”à¸¸à¸¥à¹à¸«à¹ˆà¸‡à¸Šà¸µà¸§à¸´à¸•'},
    {n:'Netzach',heb:'× Ö¶×¦Ö·×—',arch:'Haniel',score:760,th:'à¸Šà¸±à¸¢à¸Šà¸™à¸° â€” à¸„à¸§à¸²à¸¡à¸£à¸±à¸à¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¸‡à¸²à¸¡'},
    {n:'Hod',heb:'×”×•Ö¹×“',arch:'Raphael',score:740,th:'à¸„à¸§à¸²à¸¡à¸£à¸¸à¹ˆà¸‡à¹€à¸£à¸·à¸­à¸‡ â€” à¸ªà¸·à¹ˆà¸­à¸ªà¸²à¸£à¹à¸¥à¸°à¸›à¸±à¸à¸à¸²'},
    {n:'Yesod',heb:'×™Ö°×¡×•Ö¹×“',arch:'Gabriel',score:750,th:'à¸£à¸²à¸à¸à¸²à¸™ â€” à¸ˆà¸´à¸•à¹ƒà¸•à¹‰à¸ªà¸³à¸™à¸¶à¸à¹à¸¥à¸°à¸ˆà¸±à¸™à¸—à¸£à¹Œ'},
    {n:'Malkuth',heb:'×žÖ·×œÖ°×›×•Ö¼×ª',arch:'Sandalphon',score:720,th:'à¸£à¸²à¸Šà¸­à¸²à¸“à¸²à¸ˆà¸±à¸à¸£ â€” à¹‚à¸¥à¸à¸§à¸±à¸•à¸–à¸¸'},
  ];
  const MAZALOT = ['×˜Ö°×œÖµ×”','×©××•Ö¹×¨','×ªÖ°Ö¼××•Ö¹×žÖ´×™×','×¡Ö·×¨Ö°×˜Ö¸×Ÿ','×Ö·×¨Ö°×™Öµ×”','×‘Ö°Ö¼×ª×•Ö¼×œÖ¸×”','×žÖ¹××–Ö°× Ö·×™Ö´×','×¢Ö·×§Ö°×¨Ö¸×‘','×§Ö¶×©Ö¶××ª','×’Ö°Ö¼×“Ö´×™','×“Ö°Ö¼×œÖ´×™','×“Ö¸Ö¼×’Ö´×™×'];
  const MAZALOT_TH = ['à¹€à¸¡à¸© (×˜Ö°×œÖµ×”)','à¸žà¸¤à¸©à¸  (×©××•Ö¹×¨)','à¹€à¸¡à¸–à¸¸à¸™ (×ªÖ°Ö¼××•Ö¹×žÖ´×™×)','à¸à¸£à¸à¸Ž (×¡Ö·×¨Ö°×˜Ö¸×Ÿ)','à¸ªà¸´à¸‡à¸«à¹Œ (×Ö·×¨Ö°×™Öµ×”)','à¸à¸±à¸™à¸¢à¹Œ (×‘Ö°Ö¼×ª×•Ö¼×œÖ¸×”)','à¸•à¸¸à¸¥à¸¢à¹Œ (×žÖ¹××–Ö°× Ö·×™Ö´×)','à¸žà¸´à¸ˆà¸´à¸ (×¢Ö·×§Ö°×¨Ö¸×‘)','à¸˜à¸™à¸¹ (×§Ö¶×©Ö¶××ª)','à¸¡à¸à¸£ (×’Ö°Ö¼×“Ö´×™)','à¸à¸¸à¸¡à¸ à¹Œ (×“Ö°Ö¼×œÖ´×™)','à¸¡à¸µà¸™ (×“Ö¸Ö¼×’Ö´×™×)'];
  const sephiraIdx = (d.month - 1) % 10;
  const sephira = SEPHIROT[sephiraIdx];
  const mazalIdx = ((d.month - 1)) % 12;
  const hebrewYear = d.year + 3760;
  const variation = (d.day * 13 + d.hour * 7) % 60 - 30;
  const score = Math.max(440, Math.min(950, sephira.score + variation));
  return {
    sephira: sephira.n, sephiraHebrew: sephira.heb, archangel: sephira.arch,
    hebrewYear, mazal: MAZALOT[mazalIdx], mazalTh: MAZALOT_TH[mazalIdx],
    score,
    reading: `Kabbalah: Sephira ${sephira.n} (${sephira.heb}) â€” ${sephira.th} à¸›à¸à¸„à¸£à¸­à¸‡à¹‚à¸”à¸¢ ${sephira.arch} | Mazal: ${MAZALOT_TH[mazalIdx]} à¸›à¸µà¸®à¸µà¸šà¸£à¸¹ ${hebrewYear}`,
  };
}

// â”€â”€ ZOROASTRIAN â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcZoroastrian(d: BirthData): ZoroastrianData {
  const DAY_YAZATA = [
    'Ahura Mazda','Vohu Manah','Asha Vahishta','Khshathra Vairya','Spenta Armaiti',
    'Haurvatat','Ameretat','Dae','Atar (à¹„à¸Ÿ)','Aban (à¸™à¹‰à¸³)','Khorshed (à¸­à¸²à¸—à¸´à¸•à¸¢à¹Œ)','Mah (à¸ˆà¸±à¸™à¸—à¸£à¹Œ)',
    'Tishtrya (à¸à¸™)','Geus (à¸§à¸±à¸§)','Dadar','Mithra (à¸ªà¸±à¸à¸à¸²)','Sraosha (à¸§à¸´à¸™à¸±à¸¢)','Rashnu (à¸„à¸§à¸²à¸¡à¸¢à¸¸à¸•à¸´à¸˜à¸£à¸£à¸¡)',
    'Fravashi','Verethraghna (à¸Šà¸±à¸¢à¸Šà¸™à¸°)','Rama','Vata (à¸¥à¸¡)','Daena (à¸¨à¸£à¸±à¸—à¸˜à¸²)','Ashi (à¹‚à¸Šà¸„)',
    'Arshtat (à¸„à¸§à¸²à¸¡à¸‹à¸·à¹ˆà¸­à¸ªà¸±à¸•à¸¢à¹Œ)','Asman (à¸Ÿà¹‰à¸²)','Zamyad (à¹‚à¸¥à¸)','Mahraspand (à¸§à¸²à¸ˆà¸²)','Anagran (à¹à¸ªà¸‡à¹„à¸¡à¹ˆà¸£à¸¹à¹‰à¸”à¸±à¸š)','Dae2',
  ];
  const DAY_YAZATA_SCORE = [820,800,810,790,780,810,800,700,800,790,800,780,760,750,720,800,790,790,770,800,780,760,770,800,780,810,780,790,820,700];
  const MONTH_AMESHA = [
    {n:'Farvardin (Fravashi)',th:'à¹€à¸”à¸·à¸­à¸™à¸§à¸´à¸à¸à¸²à¸“à¸šà¸£à¸£à¸žà¸šà¸¸à¸£à¸¸à¸©',el:'à¸”à¸´à¸™'},
    {n:'Ardibehesht (Asha)',th:'à¹€à¸”à¸·à¸­à¸™à¸„à¸§à¸²à¸¡à¸ˆà¸£à¸´à¸‡-à¹„à¸Ÿ',el:'à¹„à¸Ÿ'},
    {n:'Khordad (Haurvatat)',th:'à¹€à¸”à¸·à¸­à¸™à¸„à¸§à¸²à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œ',el:'à¸™à¹‰à¸³'},
    {n:'Tir (Tishtrya)',th:'à¹€à¸”à¸·à¸­à¸™à¸”à¸²à¸§à¸à¸™',el:'à¸™à¹‰à¸³'},
    {n:'Mordad (Ameretat)',th:'à¹€à¸”à¸·à¸­à¸™à¸„à¸§à¸²à¸¡à¹€à¸›à¹‡à¸™à¸­à¸¡à¸•à¸°',el:'à¹„à¸¡à¹‰'},
    {n:'Shahrivar (Khshathra)',th:'à¹€à¸”à¸·à¸­à¸™à¸­à¸³à¸™à¸²à¸ˆà¸”à¸µ',el:'à¹‚à¸¥à¸«à¸°'},
    {n:'Mehr (Mithra)',th:'à¹€à¸”à¸·à¸­à¸™à¸žà¸±à¸™à¸˜à¸ªà¸±à¸à¸à¸²',el:'à¹„à¸Ÿ'},
    {n:'Aban (Anahita)',th:'à¹€à¸”à¸·à¸­à¸™à¸™à¹‰à¸³',el:'à¸™à¹‰à¸³'},
    {n:'Azar (Atar)',th:'à¹€à¸”à¸·à¸­à¸™à¹„à¸Ÿ',el:'à¹„à¸Ÿ'},
    {n:'Dey (Dae)',th:'à¹€à¸”à¸·à¸­à¸™à¸œà¸¹à¹‰à¸ªà¸£à¹‰à¸²à¸‡',el:'à¸”à¸´à¸™'},
    {n:'Bahman (Vohu Manah)',th:'à¹€à¸”à¸·à¸­à¸™à¸ˆà¸´à¸•à¹ƒà¸ˆà¸”à¸µ',el:'à¸¥à¸¡'},
    {n:'Esfand (Spenta Armaiti)',th:'à¹€à¸”à¸·à¸­à¸™à¸žà¸£à¸°à¹à¸¡à¹ˆà¸”à¸´à¸™',el:'à¸”à¸´à¸™'},
  ];
  const dayIdx = (d.day - 1) % 30;
  const monthIdx = (d.month - 1) % 12;
  const yazata = DAY_YAZATA[dayIdx];
  const amesha = MONTH_AMESHA[monthIdx];
  const harmony = yazata.includes('à¹„à¸Ÿ') === amesha.el.includes('à¹„à¸Ÿ');
  const base = DAY_YAZATA_SCORE[dayIdx] ?? 720;
  const variation = (d.year % 100 + d.hour * 5) % 80 - 40;
  const score = Math.max(430, Math.min(950, base + variation + (harmony ? 30 : 0)));
  return {
    dayYazata: yazata, dayYazataTh: yazata,
    monthAmesha: amesha.n, monthAmeshaTh: amesha.th,
    harmony, score,
    reading: `Zoroastrian: à¸§à¸±à¸™${yazata} | à¹€à¸”à¸·à¸­à¸™${amesha.th} (${amesha.el}) ${harmony?'â€” à¸˜à¸²à¸•à¸¸à¸ªà¸­à¸”à¸„à¸¥à¹‰à¸­à¸‡ à¹€à¸ªà¸£à¸´à¸¡à¸žà¸¥à¸±à¸‡':'â€” à¸˜à¸²à¸•à¸¸à¸•à¹ˆà¸²à¸‡à¸à¸±à¸™ à¸ªà¸£à¹‰à¸²à¸‡à¸ªà¸¡à¸”à¸¸à¸¥'}`,
  };
}

// â”€â”€ AZTEC TONALPOHUALLI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcAztec(d: BirthData): AztecData {
  const DAY_SIGNS = [
    {s:'Cipactli',th:'à¸ˆà¸£à¸°à¹€à¸‚à¹‰',q:'à¸à¸²à¸£à¹€à¸£à¸´à¹ˆà¸¡à¸•à¹‰à¸™',score:780},
    {s:'Ehecatl',th:'à¸¥à¸¡',q:'à¸à¸²à¸£à¸ªà¸·à¹ˆà¸­à¸ªà¸²à¸£',score:760},
    {s:'Calli',th:'à¸šà¹‰à¸²à¸™',q:'à¸„à¸§à¸²à¸¡à¸¡à¸±à¹ˆà¸™à¸„à¸‡',score:740},
    {s:'Cuetzpallin',th:'à¸ˆà¸´à¹‰à¸‡à¸ˆà¸',q:'à¸„à¸§à¸²à¸¡à¸¢à¸·à¸”à¸«à¸¢à¸¸à¹ˆà¸™',score:720},
    {s:'Coatl',th:'à¸‡à¸¹',q:'à¸à¸²à¸£à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¹à¸›à¸¥à¸‡',score:710},
    {s:'Miquiztli',th:'à¸„à¸§à¸²à¸¡à¸•à¸²à¸¢',q:'à¸à¸²à¸£à¹€à¸à¸´à¸”à¹ƒà¸«à¸¡à¹ˆ',score:650},
    {s:'Mazatl',th:'à¸à¸§à¸²à¸‡',q:'à¸„à¸§à¸²à¸¡à¸ªà¸§à¸¢à¸‡à¸²à¸¡',score:760},
    {s:'Tochtli',th:'à¸à¸£à¸°à¸•à¹ˆà¸²à¸¢',q:'à¸„à¸§à¸²à¸¡à¸­à¸¸à¸”à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œ',score:770},
    {s:'Atl',th:'à¸™à¹‰à¸³',q:'à¸à¸²à¸£à¸Šà¸³à¸£à¸°à¸¥à¹‰à¸²à¸‡',score:730},
    {s:'Itzcuintli',th:'à¸ªà¸¸à¸™à¸±à¸‚',q:'à¸„à¸§à¸²à¸¡à¸‹à¸·à¹ˆà¸­à¸ªà¸±à¸•à¸¢à¹Œ',score:760},
    {s:'Ozomatli',th:'à¸¥à¸´à¸‡',q:'à¸„à¸§à¸²à¸¡à¸ªà¸™à¸¸à¸à¸ªà¸™à¸²à¸™',score:780},
    {s:'Malinalli',th:'à¸«à¸à¹‰à¸²',q:'à¸„à¸§à¸²à¸¡à¸­à¸”à¸—à¸™',score:700},
    {s:'Acatl',th:'à¸­à¹‰à¸­',q:'à¸„à¸§à¸²à¸¡à¸¡à¸¸à¹ˆà¸‡à¸¡à¸±à¹ˆà¸™',score:780},
    {s:'Ocelotl',th:'à¹€à¸ªà¸·à¸­à¸ˆà¸²à¸à¸±à¸§à¸£à¹Œ',q:'à¸žà¸¥à¸±à¸‡à¸™à¸±à¸à¸£à¸š',score:800},
    {s:'Cuauhtli',th:'à¸­à¸´à¸™à¸—à¸£à¸µ',q:'à¸›à¸±à¸à¸à¸²à¸ªà¸¹à¸‡',score:820},
    {s:'Cozcacuauhtli',th:'à¹à¸£à¹‰à¸‡',q:'à¸­à¸²à¸¢à¸¸à¸¢à¸·à¸™',score:750},
    {s:'Ollin',th:'à¸à¸²à¸£à¹€à¸„à¸¥à¸·à¹ˆà¸­à¸™à¹„à¸«à¸§',q:'à¸Šà¸°à¸•à¸²à¸à¸£à¸£à¸¡',score:760},
    {s:'Tecpatl',th:'à¸«à¸´à¸™à¹€à¸«à¸¥à¹‡à¸à¹„à¸Ÿ',q:'à¸„à¸§à¸²à¸¡à¹€à¸”à¹‡à¸”à¸‚à¸²à¸”',score:770},
    {s:'Quiahuitl',th:'à¸à¸™',q:'à¸à¸²à¸£à¸Šà¸³à¸£à¸°à¸¥à¹‰à¸²à¸‡',score:730},
    {s:'Xochitl',th:'à¸”à¸­à¸à¹„à¸¡à¹‰',q:'à¸„à¸§à¸²à¸¡à¸‡à¸²à¸¡à¹à¸¥à¸°à¸¨à¸´à¸¥à¸›à¸°',score:790},
  ];
  // Tonalpohualli: 260-day cycle. Use JDN from known anchor
  const refJD = Math.floor(toJD(1900, 1, 1, 12));
  const birthJD = Math.floor(toJD(d.year, d.month, d.day, 12));
  const dayNum = ((birthJD - refJD) % 260 + 260) % 260;
  const daySignIdx = dayNum % 20;
  const toneNumber = (dayNum % 13) + 1;
  const TONE_NAMES = ['','Ce','Ome','Yei','Nahui','Mahkuilli','Chikuasen','Chikome','Chikuei','Chiknawi','Mahtlaktli','Mahtlaktli-On-Sey','Mahtlaktli-Omome','Mahtlaktli-Omei'];
  const sign = DAY_SIGNS[daySignIdx];
  const variation = (d.year % 100 + d.hour * 5) % 60 - 30;
  const score = Math.max(430, Math.min(950, sign.score + variation));
  return {
    daySign: sign.s, daySignTh: sign.th, toneNumber,
    toneName: TONE_NAMES[toneNumber] ?? `${toneNumber}`, daySignQuality: sign.q,
    score,
    reading: `Aztec Tonalpohualli: ${toneNumber}-${sign.s} (${sign.th}) â€” à¸„à¸¸à¸“à¸ªà¸¡à¸šà¸±à¸•à¸´: ${sign.q} à¹‚à¸—à¸™${toneNumber}à¸à¸³à¸«à¸™à¸”à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¸à¸²à¸£à¹à¸ªà¸”à¸‡à¸­à¸­à¸`,
  };
}

// â”€â”€ NATIVE AMERICAN TOTEM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcNativeAmerican(d: BirthData): NativeAmericanData {
  // 13 Moon totems based on birth date range
  const TOTEMS = [
    {t:'Snow Goose',th:'à¸«à¹ˆà¸²à¸™à¸«à¸´à¸¡à¸°',moon:'Goose Moon',clan:'Turtle Clan',el:'à¸”à¸´à¸™',score:750},   // Dec 22 - Jan 19
    {t:'Otter',th:'à¸™à¸²à¸',moon:'Rest Moon',clan:'Butterfly Clan',el:'à¸¥à¸¡',score:780},            // Jan 20 - Feb 18
    {t:'Wolf',th:'à¸«à¸¡à¸²à¸›à¹ˆà¸²',moon:'Big Winds Moon',clan:'Frog Clan',el:'à¸™à¹‰à¸³',score:800},          // Feb 19 - Mar 20
    {t:'Falcon',th:'à¹€à¸«à¸¢à¸µà¹ˆà¸¢à¸§',moon:'Budding Trees Moon',clan:'Thunderbird Clan',el:'à¹„à¸Ÿ',score:820}, // Mar 21 - Apr 19
    {t:'Beaver',th:'à¸šà¸µà¹€à¸§à¸­à¸£à¹Œ',moon:'Frogs Return Moon',clan:'Turtle Clan',el:'à¸”à¸´à¸™',score:760},  // Apr 20 - May 20
    {t:'Deer',th:'à¸à¸§à¸²à¸‡',moon:'Corn Planting Moon',clan:'Butterfly Clan',el:'à¸¥à¸¡',score:770},    // May 21 - Jun 20
    {t:'Woodpecker',th:'à¸™à¸à¸«à¸±à¸§à¸‚à¸§à¸²à¸™',moon:'Strong Sun Moon',clan:'Frog Clan',el:'à¸™à¹‰à¸³',score:740}, // Jun 21 - Jul 21
    {t:'Salmon',th:'à¸›à¸¥à¸²à¹à¸‹à¸¥à¸¡à¸­à¸™',moon:'Ripe Berries Moon',clan:'Thunderbird Clan',el:'à¹„à¸Ÿ',score:790}, // Jul 22 - Aug 21
    {t:'Brown Bear',th:'à¸«à¸¡à¸µà¸™à¹‰à¸³à¸•à¸²à¸¥',moon:'Harvest Moon',clan:'Turtle Clan',el:'à¸”à¸´à¸™',score:800}, // Aug 22 - Sep 21
    {t:'Raven',th:'à¸à¸²',moon:'Ducks Fly Moon',clan:'Butterfly Clan',el:'à¸¥à¸¡',score:810},         // Sep 22 - Oct 22
    {t:'Snake',th:'à¸‡à¸¹',moon:'Freeze Up Moon',clan:'Frog Clan',el:'à¸™à¹‰à¸³',score:730},             // Oct 23 - Nov 21
    {t:'Elk',th:'à¸à¸§à¸²à¸‡à¹ƒà¸«à¸à¹ˆ',moon:'Long Snows Moon',clan:'Thunderbird Clan',el:'à¹„à¸Ÿ',score:780},  // Nov 22 - Dec 21
    {t:'Snow Goose',th:'à¸«à¹ˆà¸²à¸™à¸«à¸´à¸¡à¸°(2)',moon:'Goose Moon',clan:'Turtle Clan',el:'à¸”à¸´à¸™',score:750}, // Dec 22+
  ];
  // Map birth date to totem by calendar
  const boundaries = [19,18,20,19,20,20,21,21,21,22,21,21,31];
  let idx = 0;
  for (let m = 1; m <= 12; m++) {
    if (d.month < m || (d.month === m && d.day <= boundaries[m-1])) { idx = m - 1; break; }
    if (m === 12) idx = 12;
  }
  // Adjust for Dec 22+ â†’ goose moon (idx 0 / 12)
  if (d.month === 12 && d.day >= 22) idx = 12;
  const totem = TOTEMS[Math.min(idx, 12)];
  const variation = (d.year % 100 + d.day * 7) % 60 - 30;
  const score = Math.max(440, Math.min(950, totem.score + variation));
  return {
    birthTotem: totem.t, birthTotemTh: totem.th, moonCycle: totem.moon,
    clansmother: totem.clan, element: totem.el,
    score,
    reading: `Native American: Birth Totem ${totem.th} (${totem.t}) | ${totem.moon} | ${totem.clan} à¸˜à¸²à¸•à¸¸${totem.el} â€” à¸ªà¸±à¸•à¸§à¹Œà¹‚à¸—à¹€à¸—à¹‡à¸¡à¸šà¹ˆà¸‡à¸–à¸¶à¸‡à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¹à¸¥à¸°à¸„à¸¸à¸“à¸¥à¸±à¸à¸©à¸“à¸°à¸Šà¸µà¸§à¸´à¸•`,
  };
}

// â”€â”€ IFA / YORUBA â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcIfaYoruba(d: BirthData): IfaYorubaData {
  const ODU = [
    {n:'Ogbe',th:'à¹‚à¸­à¸à¹€à¸š â€” à¹à¸ªà¸‡à¸ªà¸§à¹ˆà¸²à¸‡',theme:'à¸›à¸±à¸à¸à¸²à¹à¸¥à¸°à¸ˆà¸´à¸•à¸§à¸´à¸à¸à¸²à¸“',fortune:'à¹€à¸¢à¸µà¹ˆà¸¢à¸¡à¸¢à¸­à¸”',score:820},
    {n:'Oyeku',th:'à¹‚à¸­à¹€à¸¢à¸à¸¸ â€” à¸„à¸§à¸²à¸¡à¸¡à¸·à¸”',theme:'à¸à¸²à¸£à¸ªà¸´à¹‰à¸™à¸ªà¸¸à¸”à¹à¸¥à¸°à¸à¸²à¸£à¹€à¸£à¸´à¹ˆà¸¡à¸•à¹‰à¸™à¹ƒà¸«à¸¡à¹ˆ',fortune:'à¸—à¹‰à¸²à¸—à¸²à¸¢',score:610},
    {n:'Iwori',th:'à¸­à¸´à¹‚à¸§à¸£à¸´ â€” à¸«à¸±à¸§à¹ƒà¸ˆ',theme:'à¸ˆà¸´à¸•à¸§à¸´à¸à¸à¸²à¸“à¸ à¸²à¸¢à¹ƒà¸™',fortune:'à¸”à¸µ',score:760},
    {n:'Odi',th:'à¹‚à¸­à¸”à¸´ â€” à¸¡à¸”à¸¥à¸¹à¸',theme:'à¸„à¸§à¸²à¸¡à¸¥à¸¶à¸à¸¥à¸±à¸šà¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¸­à¸¸à¸”à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œ',fortune:'à¸”à¸µ',score:750},
    {n:'Irosun',th:'à¸­à¸´à¹‚à¸£à¸‹à¸¸à¸™ â€” à¹€à¸¥à¸·à¸­à¸”',theme:'à¸„à¸§à¸²à¸¡à¸ªà¸±à¸¡à¸žà¸±à¸™à¸˜à¹Œà¹à¸¥à¸°à¸£à¸±à¸',fortune:'à¸”à¸µ',score:760},
    {n:'Owonrin',th:'à¹‚à¸­à¸§à¸­à¸™à¸£à¸´à¸™ â€” à¸¥à¸¡',theme:'à¸à¸²à¸£à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¹à¸›à¸¥à¸‡',fortune:'à¸œà¸ªà¸¡',score:710},
    {n:'Obara',th:'à¹‚à¸­à¸šà¸²à¸£à¸² â€” à¸à¸©à¸±à¸•à¸£à¸´à¸¢à¹Œ',theme:'à¸„à¸§à¸²à¸¡à¸ à¸²à¸„à¸ à¸¹à¸¡à¸´à¹ƒà¸ˆà¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¸ªà¸³à¹€à¸£à¹‡à¸ˆ',fortune:'à¹€à¸¢à¸µà¹ˆà¸¢à¸¡',score:800},
    {n:'Okanran',th:'à¹‚à¸­à¸à¸±à¸™à¸£à¸±à¸™ â€” à¹„à¸Ÿ',theme:'à¸„à¸§à¸²à¸¡à¸à¸¥à¹‰à¸²à¸«à¸²à¸',fortune:'à¸”à¸µ',score:770},
    {n:'Ogunda',th:'à¹‚à¸­à¸à¸¸à¸™à¸”à¸² â€” à¹€à¸«à¸¥à¹‡à¸',theme:'à¹€à¸ªà¹‰à¸™à¸—à¸²à¸‡à¸à¸²à¸£à¸‡à¸²à¸™',fortune:'à¸”à¸µ',score:780},
    {n:'Osa',th:'à¹‚à¸­à¸‹à¸² â€”åµ',theme:'à¸„à¸§à¸²à¸¡à¸›à¸±à¹ˆà¸™à¸›à¹ˆà¸§à¸™à¹à¸¥à¸°à¸à¸²à¸£à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¹à¸›à¸¥à¸‡',fortune:'à¸œà¸ªà¸¡',score:690},
    {n:'Ika',th:'à¸­à¸´à¸à¸² â€” à¸à¸£à¸±à¸',theme:'à¸›à¸±à¸à¸«à¸²à¹à¸¥à¸°à¸à¸²à¸£à¹à¸à¹‰à¹„à¸‚',fortune:'à¸—à¹‰à¸²à¸—à¸²à¸¢',score:650},
    {n:'Oturupon',th:'à¹‚à¸­à¸•à¸¹à¸£à¸¹à¸›à¸­à¸™ â€” à¸™à¹‰à¸³à¸—à¹ˆà¸§à¸¡',theme:'à¸„à¸§à¸²à¸¡à¸­à¸¸à¸”à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œà¸ˆà¸²à¸à¸„à¸§à¸²à¸¡à¸¢à¸²à¸à¸¥à¸³à¸šà¸²à¸',fortune:'à¸œà¸ªà¸¡',score:720},
    {n:'Otura',th:'à¹‚à¸­à¸•à¸¹à¸£à¸² â€” à¸‚à¸§à¸²',theme:'à¸‚à¹‰à¸­à¸•à¸à¸¥à¸‡à¸­à¸±à¸™à¸¨à¸±à¸à¸”à¸´à¹Œà¸ªà¸´à¸—à¸˜à¸´à¹Œ',fortune:'à¸”à¸µ',score:760},
    {n:'Irete',th:'à¸­à¸´à¹€à¸£à¹€à¸• â€” à¸à¹‰à¸²à¸§à¹ƒà¸«à¸¡à¹ˆ',theme:'à¸§à¸¸à¸’à¸´à¸ à¸²à¸§à¸°à¹à¸¥à¸°à¸›à¸±à¸à¸à¸²',fortune:'à¸”à¸µ',score:770},
    {n:'Ose',th:'à¹‚à¸­à¹€à¸‹ â€” à¸„à¸§à¸²à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œ',theme:'à¸„à¸§à¸²à¸¡à¸‡à¸²à¸¡à¹à¸¥à¸°à¸Šà¸±à¸¢à¸Šà¸™à¸°',fortune:'à¹€à¸¢à¸µà¹ˆà¸¢à¸¡',score:800},
    {n:'Ofun',th:'à¹‚à¸­à¸Ÿà¸¸à¸™ â€” à¸§à¸‡à¸à¸¥à¸¡',theme:'à¸„à¸§à¸²à¸¡à¸ªà¸¡à¸šà¸¹à¸£à¸“à¹Œà¹à¸šà¸š',fortune:'à¹€à¸¢à¸µà¹ˆà¸¢à¸¡à¸ªà¸¸à¸”',score:830},
  ];
  const oduNumber = ((d.year * 3 + d.month * 7 + d.day * 11) % 16 + 16) % 16;
  const odu = ODU[oduNumber];
  const variation = (d.day * 9 + d.hour * 13) % 80 - 40;
  const score = Math.max(420, Math.min(950, odu.score + variation));
  return {
    odu: odu.n, oduTh: odu.th, oduNumber,
    oduTheme: odu.theme, fortune: odu.fortune,
    score,
    reading: `Ifa/Yoruba: OdÃ¹ ${odu.n} (${odu.th}) â€” ${odu.theme} | à¹‚à¸Šà¸„à¸Šà¸°à¸•à¸²: ${odu.fortune}`,
  };
}

// â”€â”€ ABORIGINAL DREAMTIME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcAboriginal(d: BirthData): AboriginalData {
  const ANCESTORS = [
    {a:'Rainbow Serpent',th:'à¸‡à¸¹à¸£à¸¸à¹‰à¸‡',season:'à¸¤à¸”à¸¹à¸à¸™',clan:'Water Clan',score:800},
    {a:'Bunjil Eagle',th:'à¸­à¸´à¸™à¸—à¸£à¸µà¸šà¸¸à¸™à¸ˆà¸´à¸¥',season:'à¸¤à¸”à¸¹à¹ƒà¸šà¹„à¸¡à¹‰à¸œà¸¥à¸´',clan:'Sky Clan',score:820},
    {a:'Wandjina',th:'à¸§à¸±à¸™à¸ˆà¸´à¸™à¸²',season:'à¸¤à¸”à¸¹à¸¡à¸£à¸ªà¸¸à¸¡',clan:'Cloud Clan',score:790},
    {a:'Baiame Sky Father',th:'à¸šà¸²à¸­à¸´à¹€à¸­à¹€à¸¡',season:'à¸¤à¸”à¸¹à¹à¸¥à¹‰à¸‡',clan:'Star Clan',score:810},
    {a:'Yowie Forest',th:'à¹‚à¸¢à¸§à¸µà¹ˆ',season:'à¸¤à¸”à¸¹à¸›à¹ˆà¸²',clan:'Forest Clan',score:730},
    {a:'Mimi Rock Spirits',th:'à¸¡à¸´à¸¡à¸´',season:'à¸¤à¸”à¸¹à¸«à¸´à¸™',clan:'Rock Clan',score:740},
    {a:'Namarrkun Lightning',th:'à¸™à¸²à¸¡à¸²à¸£à¹Œà¸à¸¸à¸™',season:'à¸¤à¸”à¸¹à¸Ÿà¹‰à¸²à¸£à¹‰à¸­à¸‡',clan:'Storm Clan',score:760},
    {a:'Altjira Dream Father',th:'à¸­à¸±à¸¥à¸•à¸ˆà¸´à¸£à¸²',season:'à¸—à¸¸à¸à¸¤à¸”à¸¹',clan:'Dream Clan',score:780},
    {a:'Tiddalik Frog',th:'à¸—à¸´à¸”à¸”à¸²à¸¥à¸´à¸',season:'à¸¤à¸”à¸¹à¸™à¹‰à¸³à¸—à¹ˆà¸§à¸¡',clan:'Water Clan',score:700},
    {a:'Bunyip Water',th:'à¸šà¸¸à¸™à¸¢à¸´à¸›',season:'à¸¤à¸”à¸¹à¸«à¸™à¸²à¸§',clan:'Deep Water Clan',score:710},
    {a:'Quinkans Spirits',th:'à¸„à¸§à¸´à¸™à¸à¸±à¸™',season:'à¸¤à¸”à¸¹à¹à¸«à¹‰à¸‡',clan:'Shadow Clan',score:720},
    {a:'Djang\'kawu Sisters',th:'à¸”à¸ˆà¹‰à¸²à¸‡à¸à¸²à¸§à¸¹',season:'à¸¤à¸”à¸¹à¸ªà¸£à¹‰à¸²à¸‡',clan:'Creation Clan',score:800},
  ];
  const ancestorIdx = (d.month - 1) % 12;
  const a = ANCESTORS[ancestorIdx];
  const variation = (d.day * 11 + d.year % 100 * 3) % 60 - 30;
  const score = Math.max(430, Math.min(940, a.score + variation));
  return {
    dreamingAncestor: a.a, dreamingTh: a.th,
    season: a.season, clan: a.clan,
    score,
    reading: `Aboriginal Dreamtime: ${a.th} (${a.a}) | ${a.clan} | ${a.season} â€” à¸šà¸£à¸£à¸žà¸šà¸¸à¸£à¸¸à¸© Dreaming à¸›à¸à¸›à¹‰à¸­à¸‡à¹à¸¥à¸°à¸Šà¸µà¹‰à¸™à¸³à¹€à¸ªà¹‰à¸™à¸—à¸²à¸‡à¸Šà¸µà¸§à¸´à¸•à¸•à¸²à¸¡à¸à¸Žà¸‚à¸­à¸‡à¸”à¸´à¸™à¹à¸”à¸™`,
  };
}

// â”€â”€ BIORHYTHM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcBiorhythm(d: BirthData): BiorhythmData {
  // Physical: 23-day cycle; Emotional: 28-day; Intellectual: 33-day
  // Calculate state at Apr 14, 2026 (mid-year 2026 reference)
  const refDate = toJD(2026, 4, 14, 12);
  const birthDate = toJD(d.year, d.month, d.day, 12);
  const daysSinceBirth = Math.round(refDate - birthDate);

  const PI2 = Math.PI * 2;
  const physical = Math.sin((PI2 * daysSinceBirth) / 23);
  const emotional = Math.sin((PI2 * daysSinceBirth) / 28);
  const intellectual = Math.sin((PI2 * daysSinceBirth) / 33);

  const phaseLabel = (v: number) => v > 0.5 ? 'Peak à¸ªà¸¹à¸‡à¸ªà¸¸à¸”' : v > 0 ? 'à¸‚à¸²à¸‚à¸¶à¹‰à¸™' : v > -0.5 ? 'à¸‚à¸²à¸¥à¸‡' : 'Critical à¸•à¹ˆà¸³à¸ªà¸¸à¸”';
  // Score: based on long-term cycle harmony â€” use average of 3 cycles combined
  // Normalize each cycle: (-1 to 1) â†’ (400 to 1000)
  const normalize = (v: number) => Math.round(700 + v * 200);
  const avgScore = Math.round((normalize(physical) + normalize(emotional) + normalize(intellectual)) / 3);
  const score = Math.max(430, Math.min(950, avgScore));

  return {
    physical: Math.round(physical * 100), emotional: Math.round(emotional * 100), intellectual: Math.round(intellectual * 100),
    physicalPhase: phaseLabel(physical), emotionalPhase: phaseLabel(emotional), intellectualPhase: phaseLabel(intellectual),
    score,
    reading: `Biorhythm à¸“ 14 à¹€à¸¡.à¸¢. 2026: à¸£à¹ˆà¸²à¸‡à¸à¸²à¸¢ ${Math.round(physical*100)}% (${phaseLabel(physical)}) | à¸­à¸²à¸£à¸¡à¸“à¹Œ ${Math.round(emotional*100)}% (${phaseLabel(emotional)}) | à¸ªà¸•à¸´à¸›à¸±à¸à¸à¸² ${Math.round(intellectual*100)}% (${phaseLabel(intellectual)})`,
  };
}

// â”€â”€ VEDIC MAHADASHA (extracted as separate system) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function calcVedicMahadasha(d: BirthData, vedic: VedicData): VedicMahadashaData {
  const DASHA_QUALITY: Record<string,{quality:string;el:string;score:number}> = {
    'Sun':    {quality:'à¸„à¸§à¸²à¸¡à¸¡à¸µà¸­à¸³à¸™à¸²à¸ˆà¹à¸¥à¸°à¸Šà¸·à¹ˆà¸­à¹€à¸ªà¸µà¸¢à¸‡',el:'à¹„à¸Ÿ',score:780},
    'Moon':   {quality:'à¸­à¸²à¸£à¸¡à¸“à¹Œà¹à¸¥à¸°à¸ªà¸±à¸à¸Šà¸²à¸•à¸à¸²à¸“',el:'à¸™à¹‰à¸³',score:750},
    'Mars':   {quality:'à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¸—à¹‰à¸²à¸—à¸²à¸¢',el:'à¹„à¸Ÿ',score:720},
    'Rahu':   {quality:'à¸„à¸§à¸²à¸¡à¸—à¸°à¹€à¸¢à¸­à¸—à¸°à¸¢à¸²à¸™à¹à¸¥à¸°à¸à¸²à¸£à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¹à¸›à¸¥à¸‡',el:'à¹‚à¸¥à¸«à¸°',score:700},
    'Jupiter':{quality:'à¹‚à¸Šà¸„à¸¥à¸²à¸ à¹à¸¥à¸°à¸›à¸±à¸à¸à¸²',el:'à¹„à¸¡à¹‰',score:820},
    'Saturn': {quality:'à¸„à¸§à¸²à¸¡à¸­à¸”à¸—à¸™à¹à¸¥à¸°à¸šà¸—à¹€à¸£à¸µà¸¢à¸™',el:'à¹‚à¸¥à¸«à¸°',score:710},
    'Mercury':{quality:'à¸à¸²à¸£à¸ªà¸·à¹ˆà¸­à¸ªà¸²à¸£à¹à¸¥à¸°à¸˜à¸¸à¸£à¸à¸´à¸ˆ',el:'à¸”à¸´à¸™',score:760},
    'Ketu':   {quality:'à¸ˆà¸´à¸•à¸§à¸´à¸à¸à¸²à¸“à¹à¸¥à¸°à¸à¸²à¸£à¸›à¸¥à¹ˆà¸­à¸¢à¸§à¸²à¸‡',el:'à¸”à¸´à¸™',score:700},
    'Venus':  {quality:'à¸„à¸§à¸²à¸¡à¸£à¸±à¸à¹à¸¥à¸°à¸„à¸§à¸²à¸¡à¸ªà¸£à¹‰à¸²à¸‡à¸ªà¸£à¸£à¸„à¹Œ',el:'à¹‚à¸¥à¸«à¸°',score:800},
  };
  const dq = DASHA_QUALITY[vedic.mahadasha] ?? {quality:'à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™à¸›à¸£à¸±à¸šà¸ªà¸¡à¸”à¸¸à¸¥',el:'à¸”à¸´à¸™',score:730};
  const variation = (d.day * 7 + d.month * 13) % 80 - 40;
  const score = Math.max(430, Math.min(950, dq.score + variation));
  return {
    currentDasha: vedic.mahadasha, currentDashaEnd: vedic.mahadashaEnd, antardasha: vedic.antardasha,
    dashaQuality: dq.quality, dashaElement: dq.el,
    score,
    reading: `Vedic Mahadasha: ${vedic.mahadasha} Dasha à¸–à¸¶à¸‡à¸›à¸µ ${vedic.mahadashaEnd} â€” ${dq.quality} | Antardasha ${vedic.antardasha} à¸à¸³à¸«à¸™à¸”à¸—à¸´à¸¨à¸—à¸²à¸‡à¸£à¸°à¸¢à¸°à¸ªà¸±à¹‰à¸™`,
  };
}



