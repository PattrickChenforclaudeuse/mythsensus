    {r:'áš²',n:'Kenaz',th:'à¸„à¸šà¹€à¸žà¸¥à¸´à¸‡',el:'à¹„à¸Ÿ',kw:'à¸„à¸§à¸²à¸¡à¸£à¸¹à¹‰',score:770},
    {r:'áš·',n:'Gebo',th:'à¸‚à¸­à¸‡à¸‚à¸§à¸±à¸',el:'à¸¥à¸¡',kw:'à¸à¸²à¸£à¹à¸¥à¸à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™',score:750},
