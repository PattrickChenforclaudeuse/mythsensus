# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Omise (Thai payment gateway) ─────────────────────────────────
# Dashboard: https://dashboard.omise.co → Developers → Keys
OMISE_SECRET_KEY=skey_...
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_...
OMISE_WEBHOOK_SECRET=...          # ตั้งใน Omise Dashboard → Webhooks

# Plan ID for monthly subscription
# สร้างใน Omise Dashboard → Plans → Create Plan (฿320/month)
OMISE_PLAN_ID_SUB=plan_...

# ── Anthropic (Claude API) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mythsensus.com

# ── Resend (transactional email — optional) ──────────────────────
RESEND_API_KEY=re_...

# ── Cloudflare R2 (PDF storage — Sprint 3) ───────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=mythsensus-reports
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
