{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.mythsensus.com" }],
      "destination": "https://mythsensus.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mythsensus.com" }],
      "destination": "https://mythsensus.com/:path*",
      "permanent": true
    },
    {
      "source": "/beta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/beta/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/auth/line/callback.js": { "maxDuration": 30 },
    "api/gumroad/webhook.js": { "maxDuration": 15 },
    "api/public-env.js": { "maxDuration": 5 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ]
}
